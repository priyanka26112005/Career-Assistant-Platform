n px-3 py-2.5 rounded-xl text-xs font-medium cursor-pointer transition-all',\n                      isActive\n                        ? 'bg-blue-600 text-white shadow-sm'\n                        : 'text-slate-700 hover:bg-slate-200/60'\n                    )}\n                  >\n                    <div className=\"flex items-center gap-2.5 min-w-0\">\n                      <MessageSquare className={cn('w-4 h-4 flex-shrink-0', isActive ? 'text-white' : 'text-slate-400')} />\n                      <span className=\"truncate\">{s.title}</span>\n                    </div>\n\n                    <div className={cn('flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity', isActive && 'opacity-100')}>\n                      <button\n                        onClick={(e) => openRenameModal(s, e)}\n                        className={cn('p-1 rounded hover:bg-black/10', isActive ? 'text-white' : 'text-slate-400 hover:text-slate-600')}\n                        title=\"Rename\"\n                      >\n                        <Edit2 className=\"w-3 h-3\" />\n                      </button>\n                      <button\n                        onClick={(e) => handleDeleteSession(s._id, e)}\n                        className={cn('p-1 rounded hover:bg-black/10', isActive ? 'text-white' : 'text-slate-400 hover:text-red-600')}\n                        title=\"Delete\"\n                      >\n                        <Trash2 className=\"w-3 h-3\" />\n                      </button>\n                    </div>\n                  </div>\n                );\n              })\n            )}\n          </div>\n        </div>\n\n        {/* Active Conversation Area */}\n        <div className=\"flex-1 flex flex-col bg-white\">\n          {/* Header */}\n          <div className=\"h-14 border-b border-slate-200 px-6 flex items-center justify-between bg-white\">\n            <div className=\"flex items-center gap-2\">\n              <Sparkles className=\"w-4 h-4 text-blue-600\" />\n              <span className=\"text-sm font-semibold text-slate-800\">\n                {sessions.find(s => s._id === activeSessionId)?.title || 'AI Career Coach'}\n              </span>\n            </div>\n            <span className=\"text-[11px] text-slate-400\">Context active (STAR method & interview prep)</span>\n          </div>\n\n          {/* Messages list */}\n          <div className=\"flex-1 overflow-y-auto p-6 space-y-5\">\n            {messages.length === 0 ? (\n              <div className=\"h-full flex flex-col items-center justify-center text-center max-w-md mx-auto p-6\">\n                <div className=\"w-12 h-12 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center mb-4\">\n                  <BotMessageSquare className=\"w-6 h-6\" />\n                </div>\n                <h3 className=\"text-lg font-bold text-slate-900\">How can I assist your career today?</h3>\n                <p className=\"text-xs text-slate-500 mt-2 leading-relaxed\">\n                  Ask for behavioral interview prep, STAR framework restructuring, salary negotiation scripts, or targeted resume critique.\n                </p>\n                <div className=\"mt-6 flex flex-wrap gap-2 justify-center\">\n                  <button\n                    onClick={() => setInputMessage('How do I answer \"Tell me about a time you handled a difficult conflict\"?')}\n                    className=\"text-xs text-left px-3 py-2 rounded-lg bg-slate-50 border border-slate-200 hover:border-blue-400 hover:bg-blue-50 transition-all text-slate-700\"\n                  >\n                    💡 Practice conflict resolution question\n                  </button>\n                  <button\n                    onClick={() => setInputMessage('Give me a strategic salary negotiation framework for a senior offer.')}\n                    className=\"text-xs text-left px-3 py-2 rounded-lg bg-slate-50 border border-slate-200 hover:border-blue-400 hover:bg-blue-50 transition-all text-slate-700\"\n                  >\n                    📈 Senior salary negotiation framework\n                  </button>\n                </div>\n              </div>\n            ) : (\n              messages.map((m) => {\n                const isUser = m.role === 'user';\n                return (\n                  <div key={m._id} className={cn('flex gap-3', isUser ? 'justify-end' : 'justify-start')}>\n                    {!isUser && (\n                      <div className=\"w-8 h-8 rounded-full bg-blue-600 text-white flex items-center justify-center flex-shrink-0 shadow-sm mt-0.5\">\n                        <BotMessageSquare className=\"w-4 h-4\" />\n                      </div>\n                    )}\n\n                    <div\n                      className={cn(\n                        'max-w-[75%] rounded-2xl px-4 py-3 text-sm leading-relaxed whitespace-pre-wrap shadow-sm',\n                        isUser\n                          ? 'bg-blue-600 text-white rounded-tr-none'\n                          : 'bg-slate-50 border border-slate-200 text-slate-800 rounded-tl-none'\n                      )}\n                    >\n                      {m.content}\n                    </div>\n\n                    {isUser && (\n                      <div className=\"w-8 h-8 rounded-full bg-slate-200 text-slate-700 flex items-center justify-center flex-shrink-0 shadow-sm mt-0.5\">\n                        <User className=\"w-4 h-4\" />\n                      </div>\n                    )}\n                  </div>\n                );\n              })\n            )}\n\n            {isSending && (\n              <div className=\"flex gap-3 justify-start items-center text-slate-400 text-xs\">\n                <div className=\"w-8 h-8 rounded-full bg-blue-600 text-white flex items-center justify-center flex-shrink-0 shadow-sm\">\n                  <BotMessageSquare className=\"w-4 h-4\" />\n                </div>\n                <div className=\"flex items-center gap-2 bg-slate-50 border border-slate-200 px-4 py-2.5 rounded-2xl rounded-tl-none\">\n                  <Loader2 className=\"w-3.5 h-3.5 animate-spin text-blue-600\" />\n                  <span>AI coach is formulating advice...</span>\n                </div>\n              </div>\n            )}\n            <div ref={messagesEndRef} />\n          </div>\n\n          {/* Input Form */}\n          <div className=\"p-4 border-t border-slate-200 bg-white\">\n            <form onSubmit={handleSendMessage} className=\"flex gap-2\">\n              <input\n                type=\"text\"\n                value={inputMessage}\n                onChange={(e) => setInputMessage(e.target.value)}\n                placeholder=\"Ask your AI Career Coach anything...\"\n                className=\"flex-1 rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm text-slate-900 placeholder:text-slate-400 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500\"\n              />\n              <Button type=\"submit\" isLoading={isSending} disabled={!inputMessage.trim()} className=\"px-5 rounded-xl\">\n                <Send className=\"w-4 h-4\" />\n              </Button>\n            </form>\n          </div>\n        </div>\n      </div>\n\n      {/* Rename Modal */}\n      <Modal isOpen={isRenameOpen} onClose={() => setIsRenameOpen(false)} title=\"Rename Conversation\">\n        <div className=\"space-y-4\">\n          <Input\n            label=\"Conversation Title\"\n            value={renameTitle}\n            onChange={(e) => setRenameTitle(e.target.value)}\n            placeholder=\"e.g. Senior Backend Interview Prep\"\n          />\n          <div className=\"flex justify-end gap-2 pt-2\">\n            <Button variant=\"outline\" onClick={() => setIsRenameOpen(false)}>Cancel</Button>\n            <Button onClick={handleSaveRename}>Save</Button>\n          </div>\n        </div>\n      </Modal>\n    </DashboardLayout>\n  );\n}\n","Description":"Create interactive AI Career Assistant ChatGPT-style hub page","Overwrite":true,"TargetFile":"C:\\Users\\PRIYANKA\\.gemini\\antigravity\\scratch\\career-platform\\frontend\\app\\chat\\page.tsx","toolAction":"Writing frontend/app/chat/page.tsx","toolSummary":"Create chat/page.tsx"}}]}
