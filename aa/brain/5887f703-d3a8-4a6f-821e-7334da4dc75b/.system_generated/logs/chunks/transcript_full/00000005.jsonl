{"step_index":248,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-10-13T13:12:43Z","thinking":"Building the interactive resume editor requires focusing on the `edit/page.tsx` component. The system must enable editing for various resume sections: personal information, professional summary (using rich text), work experience, education, skills, projects, certifications, and achievements. Additionally, functionality for AI-driven generation of content is needed.\n\n\n","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"'use client';\n\nimport React, { useEffect, useState } from 'react';\nimport { useParams, useRouter } from 'next/navigation';\nimport Link from 'next/link';\nimport { DashboardLayout } from '@/components/layout/DashboardLayout';\nimport { api } from '@/lib/api';\nimport { IResume, ResumeTemplateType } from '@/types';\nimport { Card, CardHeader, CardTitle, CardDescription, CardContent } from '@/components/ui/Card';\nimport { Button } from '@/components/ui/Button';\nimport { Input } from '@/components/ui/Input';\nimport { Badge } from '@/components/ui/Badge';\nimport { TiptapResumeEditor } from '@/components/editor/TiptapResumeEditor';\nimport { ResumePreview } from '@/components/templates/ResumePreview';\nimport {\n  Sparkles,\n  Save,\n  Eye,\n  Plus,\n  Trash2,\n  CheckCircle2,\n  ArrowLeft,\n  Layout,\n  AlignLeft,\n  Loader2\n} from 'lucide-react';\nimport { cn } from '@/lib/utils';\n\nexport default function ResumeEditPage() {\n  const params = useParams();\n  const router = useRouter();\n  const id = params?.id as string;\n\n  const [resume, setResume] = useState<IResume | null>(null);\n  const [loading, setLoading] = useState(true);\n  const [isSaving, setIsSaving] = useState(false);\n  const [saveToast, setSaveToast] = useState(false);\n  const [isGenerating, setIsGenerating] = useState<string | null>(null);\n\n  // New item inputs\n  const [newSkill, setNewSkill] = useState('');\n  const [newAchievement, setNewAchievement] = useState('');\n\n  useEffect(() => {\n    if (id) {\n      loadResume(id);\n    }\n  }, [id]);\n\n  const loadResume = async (resumeId: string) => {\n    try {\n      const res = await api.getResume(resumeId);\n      if (res?.data?.resume) {\n        setResume(res.data.resume);\n      }\n    } catch (err) {\n      console.error('Failed to load resume:', err);\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  const handleSave = async () => {\n    if (!resume) return;\n    setIsSaving(true);\n    try {\n      const res = await api.updateResume(resume._id, resume);\n      if (res?.data?.resume) {\n        setResume(res.data.resume);\n      }\n      setSaveToast(true);\n      setTimeout(() => setSaveToast(false), 3000);\n    } catch (err) {\n      console.error('Failed to save resume:', err);\n    } finally {\n      setIsSaving(false);\n    }\n  };\n\n  const handleAIGenerate = async (section: 'summary' | 'experience' | 'skills' | 'achievements', prompt: string) => {\n    if (!resume) return;\n    setIsGenerating(section);\n    try {\n      const res = await api.generateResumeSection(resume._id, section, prompt);\n      if (res?.data?.resume) {\n        setResume(res.data.resume);\n      }\n    } catch (err) {\n      console.error(`Failed to generate ${section}:`, err);\n    } finally {\n      setIsGenerating(null);\n    }\n  };\n\n  if (loading || !resume) {\n    return (\n      <DashboardLayout>\n        <div className=\"h-96 flex items-center justify-center text-slate-400\">\n          <Loader2 className=\"w-8 h-8 animate-spin text-blue-600\" />\n        </div>\n      </DashboardLayout>\n    );\n  }\n\n  return (\n    <DashboardLayout>\n      <div className=\"space-y-6\">\n        {/* Top Control Bar */}\n        <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-slate-200\">\n          <div className=\"flex items-center gap-3\">\n            <Link href=\"/resumes\">\n              <Button size=\"sm\" variant=\"outline\" className=\"p-2\">\n                <ArrowLeft className=\"w-4 h-4\" />\n              </Button>\n            </Link>\n            <div>\n              <input\n                type=\"text\"\n                value={resume.title}\n                onChange={(e) => setResume({ ...resume, title: e.target.value })}\n                className=\"text-xl font-bold text-slate-900 bg-transparent border-b border-transparent hover:border-slate-300 focus:border-blue-600 focus:outline-none transition-colors px-1\"\n              />\n              <p className=\"text-xs text-slate-400 px-1\">All changes are saved to your account</p>\n            </div>\n          </div>\n\n          <div className=\"flex items-center gap-3\">\n            {/* Template Selector */}\n            <div className=\"flex items-center bg-slate-100 p-1 rounded-lg border border-slate-200\">\n              <button\n                type=\"button\"\n                onClick={() => setResume({ ...resume, template: 'MODERN_PROFESSIONAL' })}\n                className={cn(\n                  'flex items-center gap-1.5 px-3 py-1.5 rounded-md text-xs font-semibold transition-colors',\n                  resume.template === 'MODERN_PROFESSIONAL'\n                    ? 'bg-white text-blue-700 shadow-sm'\n                    : 'text-slate-600 hover:text-slate-900'\n                )}\n              >\n                <Layout className=\"w-3.5 h-3.5\" /> Modern\n              </button>\n              <button\n                type=\"button\"\n                onClick={() => setResume({ ...resume, template: 'ATS_CLASSIC' })}\n                className={cn(\n                  'flex items-center gap-1.5 px-3 py-1.5 rounded-md text-xs font-semibold transition-colors',\n                  resume.template === 'ATS_CLASSIC'\n                    ? 'bg-white text-blue-700 shadow-sm'\n                    : 'text-slate-600 hover:text-slate-900'\n                )}\n              >\n                <AlignLeft className=\"w-3.5 h-3.5\" /> ATS Classic\n              </button>\n            </div>\n\n            <Link href={`/resumes/${resume._id}/preview`}>\n              <Button size=\"sm\" variant=\"outline\" className=\"gap-1.5\">\n                <Eye className=\"w-4 h-4\" /> Preview\n              </Button>\n            </Link>\n\n            <Button size=\"sm\" onClick={handleSave} isLoading={isSaving} className=\"gap-1.5 shadow-sm\">\n              <Save className=\"w-4 h-4\" /> Save\n            </Button>\n          </div>\n        </div>\n\n        {saveToast && (\n          <div className=\"p-3 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs flex items-center gap-2\">\n            <CheckCircle2 className=\"w-4 h-4 text-emerald-600 flex-shrink-0\" />\n            <span>Resume saved successfully!</span>\n          </div>\n        )}\n\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8\">\n          {/* Left Edit Column */}\n          <div className=\"lg:col-span-7 space-y-6\">\n            {/* 1. Personal Information */}\n            <Card>\n              <CardHeader>\n                <CardTitle className=\"text-sm\">Personal Information</CardTitle>\n                <CardDescription>Contact details displayed at the top of your resume</CardDescription>\n              </CardHeader>\n              <CardContent className=\"space-y-3\">\n                <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3\">\n                  <Input\n                    label=\"Full Name\"\n                    value={resume.personalInfo?.fullName || ''}\n                    onChange={(e) =>\n                      setResume({\n                        ...resume,\n                        personalInfo: { ...resume.personalInfo, fullName: e.target.value },\n                      })\n                    }\n                    placeholder=\"e.g. Alice Johnson\"\n                  />\n                  <Input\n                    label=\"Email\"\n                    value={resume.personalInfo?.email || ''}\n                    onChange={(e) =>\n                      setResume({\n                        ...resume,\n                        personalInfo: { ...resume.personalInfo, email: e.target.value },\n                      })\n                    }\n                    placeholder=\"alice@example.com\"\n                  />\n                </div>\n                <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3\">\n                  <Input\n                    label=\"Phone\"\n                    value={resume.personalInfo?.phone || ''}\n                    onChange={(e) =>\n                      setResume({\n                        ...resume,\n                        personalInfo: { ...resume.personalInfo, phone: e.target.value },\n                      })\n                    }\n                    placeholder=\"+1 555-0199\"\n                  />\n                  <Input\n                    label=\"Location\"\n                    value={resume.personalInfo?.location || ''}\n                    onChange={(e) =>\n                      setResume({\n                        ...resume,\n                        personalInfo: { ...resume.personalInfo, location: e.target.value },\n                      })\n                    }\n                    placeholder=\"San Francisco, CA\"\n                  />\n                </div>\n                <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3\">\n                  <Input\n                    label=\"LinkedIn URL\"\n                    value={resume.personalInfo?.linkedin || ''}\n                    onChange={(e) =>\n                      setResume({\n                        ...resume,\n                        personalInfo: { ...resume.personalInfo, linkedin: e.target.value },\n                      })\n                    }\n                    placeholder=\"https://linkedin.com/in/alice\"\n                  />\n                  <Input\n                    label=\"Portfolio / Website\"\n                    value={resume.personalInfo?.website || ''}\n                    onChange={(e) =>\n                      setResume({\n                        ...resume,\n                        personalInfo: { ...resume.personalInfo, website: e.target.value },\n                      })\n                    }\n                    placeholder=\"https://alice.dev\"\n                  />\n                </div>\n              </CardContent>\n            </Card>\n\n            {/* 2. Professional Summary with AI Generate */}\n            <Card>\n              <CardHeader className=\"flex flex-row items-center justify-between pb-2\">\n                <div>\n                  <CardTitle className=\"text-sm\">Professional Summary</CardTitle>\n                  <CardDescription>A compelling overview of your career and value</CardDescription>\n                </div>\n                <Button\n                  size=\"sm\"\n                  variant=\"ghost\"\n                  onClick={() =>\n                    handleAIGenerate(\n                      'summary',\n                      `Create an impactful summary for ${resume.personalInfo?.fullName || 'a senior professional'} in tech.`\n                    )\n                  }\n                  isLoading={isGenerating === 'summary'}\n                  className=\"text-xs text-blue-600 gap-1.5\"\n                >\n                  <Sparkles className=\"w-3.5 h-3.5\" /> AI Generate\n                </Button>\n              </CardHeader>\n              <CardContent>\n                <TiptapResumeEditor\n                  content={resume.summary || ''}\n                  onChange={(newHtml) => setResume({ ...resume, summary: newHtml })}\n                />\n              </CardContent>\n            </Card>\n\n            {/* 3. Work Experience */}\n            <Card>\n              <CardHeader className=\"flex flex-row items-center justify-between pb-2\">\n                <div>\n                  <CardTitle className=\"text-sm\">Work Experience</CardTitle>\n                  <CardDescription>Highlight leadership, metrics, and achievements</CardDescription>\n                </div>\n                <Button\n                  size=\"sm\"\n                  variant=\"ghost\"\n                  onClick={() =>\n                    handleAIGenerate(\n                      'experience',\n                      'Generate strong metrics-driven engineering work experience entries with bullet points.'\n                    )\n                  }\n                  isLoading={isGenerating === 'experience'}\n                  className=\"text-xs text-blue-600 gap-1.5\"\n                >\n                  <Sparkles className=\"w-3.5 h-3.5\" /> AI Suggest\n                </Button>\n              </CardHeader>\n              <CardContent className=\"space-y-4\">\n                {resume.experience?.map((exp, idx) => (\n                  <div key={exp.id || idx} className=\"p-4 rounded-xl border border-slate-200 bg-slate-50/50 space-y-3\">\n                    <div className=\"flex justify-between items-center\">\n                      <span className=\"text-xs font-bold text-slate-700\">Role #{idx + 1}</span>\n                      <button\n                        type=\"button\"\n                        onClick={() =>\n                          setResume({\n                            ...resume,\n                            experience: resume.experience.filter((_, i) => i !== idx),\n                          })\n                        }\n                        className=\"text-slate-400 hover:text-red-600 transition-colors p-1\"\n                      >\n                        <Trash2 className=\"w-3.5 h-3.5\" />\n                      </button>\n                    </div>\n\n                    <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3\">\n                      <Input\n                        label=\"Job Title\"\n                        value={exp.role}\n                        onChange={(e) => {\n                          const updated = [...resume.experience];\n                          updated[idx].role = e.target.value;\n                          setResume({ ...resume, experience: updated });\n                        }}\n                      />\n                      <Input\n                        label=\"Company\"\n                        value={exp.company}\n                        onChange={(e) => {\n                          const updated = [...resume.experience];\n                          updated[idx].company = e.target.value;\n                          setResume({ ...resume, experience: updated });\n                        }}\n                      />\n                    </div>\n\n                    <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3\">\n                      <Input\n                        label=\"Start Date\"\n                        value={exp.startDate || ''}\n                        onChange={(e) => {\n                          const updated = [...resume.experience];\n                          updated[idx].startDate = e.target.value;\n                          setResume({ ...resume, experience: updated });\n                        }}\n                        placeholder=\"2022-01\"\n                      />\n                      <Input\n                        label=\"End Date\"\n                        value={exp.endDate || ''}\n                        onChange={(e) => {\n                          const updated = [...resume.experience];\n                          updated[idx].endDate = e.target.value;\n                          setResume({ ...resume, experience: updated });\n                        }}\n                        placeholder=\"Present\"\n                      />\n                    </div>\n\n                    <div>\n                      <label className=\"block text-xs font-medium text-slate-700 mb-1\">Role Description / Highlights</label>\n                      <TiptapResumeEditor\n                        content={exp.description || ''}\n                        onChange={(html) => {\n                          const updated = [...resume.experience];\n                          updated[idx].description = html;\n                          setResume({ ...resume, experience: updated });\n                        }}\n                      />\n                    </div>\n                  </div>\n                ))}\n\n                <Button\n                  type=\"button\"\n                  variant=\"outline\"\n                  size=\"sm\"\n                  onClick={() =>\n                    setResume({\n                      ...resume,\n                      experience: [\n                        ...(resume.experience || []),\n                        {\n                          id: `exp_${Date.now()}`,\n                          company: 'New Company',\n                          role: 'Software Engineer',\n                          startDate: '2023-01',\n                          endDate: 'Present',\n                          current: true,\n                          description: '<p>Led high-impact project deliveries.</p>',\n                          highlights: [],\n                        },\n                      ],\n                    })\n                  }\n                  className=\"w-full gap-2 border-dashed\"\n                >\n                  <Plus className=\"w-4 h-4\" /> Add Experience Entry\n                </Button>\n              </CardContent>\n            </Card>\n\n            {/* 4. Skills */}\n            <Card>\n              <CardHeader className=\"flex flex-row items-center justify-between pb-2\">\n                <div>\n                  <CardTitle className=\"text-sm\">Skills & Competencies</CardTitle>\n                  <CardDescription>Core tools, languages, and architectures</CardDescription>\n                </div>\n                <Button\n                  size=\"sm\"\n                  variant=\"ghost\"\n                  onClick={() =>\n                    handleAIGenerate('skills', 'Suggest high-leverage modern technical and system skills.')\n                  }\n                  isLoading={isGenerating === 'skills'}\n                  className=\"text-xs text-blue-600 gap-1.5\"\n                >\n                  <Sparkles className=\"w-3.5 h-3.5\" /> AI Suggest\n                </Button>\n              </CardHeader>\n              <CardContent className=\"space-y-3\">\n                <div className=\"flex gap-2\">\n                  <Input\n                    value={newSkill}\n                    onChange={(e) => setNewSkill(e.target.value)}\n                    placeholder=\"Add skill (e.g. TypeScript, Docker)\"\n                    onKeyDown={(e) => {\n                      if (e.key === 'Enter') {\n                        e.preventDefault();\n                        if (newSkill.trim()) {\n                          setResume({\n                            ...resume,\n                            skills: [...(resume.skills || []), newSkill.trim()],\n                          });\n                          setNewSkill('');\n                        }\n                      }\n                    }}\n                  />\n                  <Button\n                    type=\"button\"\n                    onClick={() => {\n                      if (newSkill.trim()) {\n                        setResume({\n                          ...resume,\n                          skills: [...(resume.skills || []), newSkill.trim()],\n                        });\n                        setNewSkill('');\n                      }\n                    }}\n                    variant=\"secondary\"\n                    className=\"flex-shrink-0\"\n                  >\n                    Add\n                  </Button>\n                </div>\n\n                <div className=\"flex flex-wrap gap-1.5\">\n                  {resume.skills?.map((s, idx) => (\n                    <span\n                      key={idx}\n                      className=\"inline-flex items-center gap-1.5 rounded-lg bg-slate-100 border border-slate-200 px-2.5 py-1 text-xs font-medium text-slate-700\"\n                    >\n                      {s}\n                      <button\n                        type=\"button\"\n                        onClick={() =>\n                          setResume({\n                            ...resume,\n                            skills: resume.skills.filter((_, i) => i !== idx),\n                          })\n                        }\n                        className=\"hover:text-red-600 transition-colors\"\n                      >\n                        <Trash2 className=\"w-3 h-3\" />\n                      </button>\n                    </span>\n                  ))}\n                </div>\n              </CardContent>\n            </Card>\n\n            {/* 5. Education */}\n            <Card>\n              <CardHeader className=\"flex flex-row items-center justify-between pb-2\">\n                <div>\n                  <CardTitle className=\"text-sm\">Education</CardTitle>\n                  <CardDescription>Academic degrees and certificates</CardDescription>\n                </div>\n                <Button\n                  type=\"button\"\n                  size=\"sm\"\n                  variant=\"outline\"\n                  onClick={() =>\n                    setResume({\n                      ...resume,\n                      education: [\n                        ...(resume.education || []),\n                        {\n                          id: `edu_${Date.now()}`,\n                          institution: 'University Name',\n                          degree: 'B.S. in Computer Science',\n                          startDate: '2016',\n                          endDate: '2020',\n                        },\n                      ],\n                    })\n                  }\n                  className=\"gap-1.5 text-xs\"\n                >\n                  <Plus className=\"w-3.5 h-3.5\" /> Add School\n                </Button>\n              </CardHeader>\n              <CardContent className=\"space-y-3\">\n                {resume.education?.map((edu, idx) => (\n                  <div key={edu.id || idx} className=\"p-3.5 rounded-xl border border-slate-200 bg-slate-50/50 space-y-2\">\n                    <div className=\"flex justify-between items-center\">\n                      <span className=\"text-xs font-bold text-slate-700\">Education #{idx + 1}</span>\n                      <button\n                        type=\"button\"\n                        onClick={() =>\n                          setResume({\n                            ...resume,\n                            education: resume.education.filter((_, i) => i !== idx),\n                          })\n                        }\n                        className=\"text-slate-400 hover:text-red-600 p-1\"\n                      >\n                        <Trash2 className=\"w-3.5 h-3.5\" />\n                      </button>\n                    </div>\n\n                    <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3\">\n                      <Input\n                        label=\"Institution\"\n                        value={edu.institution}\n                        onChange={(e) => {\n                          const updated = [...resume.education];\n                          updated[idx].institution = e.target.value;\n                          setResume({ ...resume, education: updated });\n                        }}\n                      />\n                      <Input\n                        label=\"Degree / Major\"\n                        value={edu.degree}\n                        onChange={(e) => {\n                          const updated = [...resume.education];\n                          updated[idx].degree = e.target.value;\n                          setResume({ ...resume, education: updated });\n                        }}\n                      />\n                    </div>\n                  </div>\n                ))}\n              </CardContent>\n            </Card>\n          </div>\n\n          {/* Right Live Preview Column */}\n          <div className=\"lg:col-span-5\">\n            <div className=\"sticky top-24 space-y-3\">\n              <div className=\"flex items-center justify-between px-1\">\n                <span className=\"text-xs font-bold uppercase tracking-wider text-slate-500\">\n                  Live Preview ({resume.template === 'ATS_CLASSIC' ? 'ATS Classic' : 'Modern Professional'})\n                </span>\n                <Link href={`/resumes/${resume._id}/preview`} className=\"text-xs text-blue-600 hover:underline\">\n                  Full View\n                </Link>\n              </div>\n\n              <div className=\"rounded-xl border border-slate-300 bg-slate-100 p-3 max-h-[calc(100vh-10rem)] overflow-y-auto shadow-inner\">\n                <div className=\"scale-[0.85] origin-top\">\n                  <ResumePreview resume={resume} />\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </DashboardLayout>\n  );\n}\n","Description":"Create comprehensive full-featured Resume Editor page with Tiptap, AI generation, and live template preview","Overwrite":true,"TargetFile":"C:\\Users\\PRIYANKA\\.gemini\\antigravity\\scratch\\career-platform\\frontend\\app\\resumes\\[id]\\edit\\page.tsx","toolAction":"Writing frontend/app/resumes/[id]/edit/page.tsx","toolSummary":"Create resumes/[id]/edit/page.tsx"}}]}
