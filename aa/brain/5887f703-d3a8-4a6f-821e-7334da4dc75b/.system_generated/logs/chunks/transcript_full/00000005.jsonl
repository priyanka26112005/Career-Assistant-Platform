{"step_index":244,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-10-13T13:12:08Z","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"'use client';\n\nimport React, { useEffect, useState } from 'react';\nimport Link from 'next/link';\nimport { DashboardLayout } from '@/components/layout/DashboardLayout';\nimport { api } from '@/lib/api';\nimport { IResume } from '@/types';\nimport { Card, CardHeader, CardTitle, CardContent } from '@/components/ui/Card';\nimport { Button } from '@/components/ui/Button';\nimport { Badge } from '@/components/ui/Badge';\nimport { Skeleton } from '@/components/ui/Skeleton';\nimport { formatDate } from '@/lib/utils';\nimport {\n  FileText,\n  Plus,\n  Eye,\n  Edit,\n  Trash2,\n  Download,\n  Sparkles\n} from 'lucide-react';\n\nexport default function ResumesListPage() {\n  const [resumes, setResumes] = useState<IResume[]>([]);\n  const [loading, setLoading] = useState(true);\n\n  useEffect(() => {\n    loadResumes();\n  }, []);\n\n  const loadResumes = async () => {\n    try {\n      const res = await api.getResumes();\n      if (res?.data?.resumes) {\n        setResumes(res.data.resumes);\n      }\n    } catch (err) {\n      console.error('Failed to load resumes:', err);\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  const handleDelete = async (id: string, title: string) => {\n    if (!confirm(`Are you sure you want to delete \"${title}\"?`)) return;\n    try {\n      await api.deleteResume(id);\n      setResumes(resumes.filter(r => r._id !== id));\n    } catch (err) {\n      console.error('Failed to delete resume:', err);\n    }\n  };\n\n  return (\n    <DashboardLayout>\n      <div className=\"space-y-8\">\n        <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n          <div>\n            <h1 className=\"text-2xl font-bold tracking-tight text-slate-900\">My Resumes</h1>\n            <p className=\"text-sm text-slate-500 mt-1\">\n              Create, edit, and export tailored ATS-friendly and Modern Professional resumes.\n            </p>\n          </div>\n          <Link href=\"/resumes/create\">\n            <Button className=\"gap-2\">\n              <Plus className=\"w-4 h-4\" /> Create New Resume\n            </Button>\n          </Link>\n        </div>\n\n        {loading ? (\n          <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6\">\n            <Skeleton className=\"h-48 w-full\" />\n            <Skeleton className=\"h-48 w-full\" />\n            <Skeleton className=\"h-48 w-full\" />\n          </div>\n        ) : resumes.length === 0 ? (\n          <Card className=\"py-16 text-center\">\n            <div className=\"w-12 h-12 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center mx-auto mb-4\">\n              <FileText className=\"w-6 h-6\" />\n            </div>\n            <h3 className=\"text-lg font-bold text-slate-900\">No resumes created yet</h3>\n            <p className=\"text-sm text-slate-500 max-w-sm mx-auto mt-1 mb-6\">\n              Start building your professional resume with AI-assisted bullet points and ATS optimization.\n            </p>\n            <Link href=\"/resumes/create\">\n              <Button className=\"gap-2\">\n                <Plus className=\"w-4 h-4\" /> Create Your First Resume\n              </Button>\n            </Link>\n          </Card>\n        ) : (\n          <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6\">\n            {resumes.map((resume) => (\n              <Card key={resume._id} className=\"flex flex-col justify-between hover:border-slate-300 transition-all\">\n                <CardHeader>\n                  <div className=\"flex items-start justify-between gap-2\">\n                    <CardTitle className=\"text-base font-bold line-clamp-1\">\n                      {resume.title}\n                    </CardTitle>\n                    <Badge variant={resume.template === 'ATS_CLASSIC' ? 'neutral' : 'primary'}>\n                      {resume.template === 'ATS_CLASSIC' ? 'ATS Classic' : 'Modern Professional'}\n                    </Badge>\n                  </div>\n                  <p className=\"text-xs text-slate-400 mt-1\">\n                    Last updated {formatDate(resume.updatedAt)}\n                  </p>\n                </CardHeader>\n\n                <CardContent>\n                  <p className=\"text-xs text-slate-600 line-clamp-2 mb-4\">\n                    {resume.summary ? resume.summary.replace(/<[^>]+>/g, '') : 'No summary provided yet.'}\n                  </p>\n\n                  <div className=\"flex flex-wrap gap-1 mb-4\">\n                    {resume.skills?.slice(0, 4).map((s, idx) => (\n                      <span key={idx} className=\"px-2 py-0.5 rounded bg-slate-100 text-[11px] text-slate-600 font-medium\">\n                        {s}\n                      </span>\n                    ))}\n                    {(resume.skills?.length || 0) > 4 && (\n                      <span className=\"text-[11px] text-slate-400 self-center\">\n                        +{(resume.skills?.length || 0) - 4} more\n                      </span>\n                    )}\n                  </div>\n\n                  <div className=\"pt-4 border-t border-slate-100 flex items-center justify-between\">\n                    <div className=\"flex items-center gap-1\">\n                      <Link href={`/resumes/${resume._id}/edit`}>\n                        <Button size=\"sm\" variant=\"ghost\" className=\"gap-1.5 text-xs text-blue-600\">\n                          <Edit className=\"w-3.5 h-3.5\" /> Edit\n                        </Button>\n                      </Link>\n                      <Link href={`/resumes/${resume._id}/preview`}>\n                        <Button size=\"sm\" variant=\"ghost\" className=\"gap-1.5 text-xs text-slate-600\">\n                          <Eye className=\"w-3.5 h-3.5\" /> Preview\n                        </Button>\n                      </Link>\n                    </div>\n\n                    <button\n                      onClick={() => handleDelete(resume._id, resume.title)}\n                      className=\"p-1.5 rounded-lg text-slate-400 hover:text-red-600 hover:bg-red-50 transition-colors\"\n                      title=\"Delete resume\"\n                    >\n                      <Trash2 className=\"w-4 h-4\" />\n                    </button>\n                  </div>\n                </CardContent>\n              </Card>\n            ))}\n          </div>\n        )}\n      </div>\n    </DashboardLayout>\n  );\n}\n","Description":"Create Resumes list page component","Overwrite":true,"TargetFile":"C:\\Users\\PRIYANKA\\.gemini\\antigravity\\scratch\\career-platform\\frontend\\app\\resumes\\page.tsx","toolAction":"Writing frontend/app/resumes/page.tsx","toolSummary":"Create resumes/page.tsx"}}]}
