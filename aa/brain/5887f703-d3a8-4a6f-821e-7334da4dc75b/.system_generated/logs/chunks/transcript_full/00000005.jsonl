{"step_index":250,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-10-13T13:13:22Z","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"'use client';\n\nimport React, { useEffect, useState } from 'react';\nimport { useParams, useRouter } from 'next/navigation';\nimport Link from 'next/link';\nimport { DashboardLayout } from '@/components/layout/DashboardLayout';\nimport { api } from '@/lib/api';\nimport { IResume, ResumeTemplateType } from '@/types';\nimport { ResumePreview } from '@/components/templates/ResumePreview';\nimport { Button } from '@/components/ui/Button';\nimport {\n  Printer,\n  Download,\n  Edit,\n  ArrowLeft,\n  Layout,\n  AlignLeft,\n  Loader2\n} from 'lucide-react';\nimport { cn } from '@/lib/utils';\n\nexport default function ResumePreviewPage() {\n  const params = useParams();\n  const router = useRouter();\n  const id = params?.id as string;\n\n  const [resume, setResume] = useState<IResume | null>(null);\n  const [selectedTemplate, setSelectedTemplate] = useState<ResumeTemplateType>('MODERN_PROFESSIONAL');\n  const [loading, setLoading] = useState(true);\n\n  useEffect(() => {\n    if (id) {\n      api.getResume(id)\n        .then((res) => {\n          if (res?.data?.resume) {\n            setResume(res.data.resume);\n            setSelectedTemplate(res.data.resume.template || 'MODERN_PROFESSIONAL');\n          }\n        })\n        .catch((err) => console.error(err))\n        .finally(() => setLoading(false));\n    }\n  }, [id]);\n\n  const handlePrint = () => {\n    window.print();\n  };\n\n  const handleDownloadHtml = async () => {\n    if (!resume) return;\n    try {\n      const res = await api.exportResume(resume._id, selectedTemplate);\n      if (res?.data?.html) {\n        const blob = new Blob([res.data.html], { type: 'text/html' });\n        const url = URL.createObjectURL(blob);\n        const a = document.createElement('a');\n        a.href = url;\n        a.download = `${resume.title.replace(/\\s+/g, '_')}_${selectedTemplate}.html`;\n        a.click();\n        URL.revokeObjectURL(url);\n      }\n    } catch (err) {\n      console.error('Failed to download resume:', err);\n    }\n  };\n\n  if (loading || !resume) {\n    return (\n      <DashboardLayout>\n        <div className=\"h-96 flex items-center justify-center text-slate-400\">\n          <Loader2 className=\"w-8 h-8 animate-spin text-blue-600\" />\n        </div>\n      </DashboardLayout>\n    );\n  }\n\n  return (\n    <DashboardLayout>\n      <div className=\"space-y-6\">\n        {/* Print / Export Control Bar */}\n        <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-slate-200 print:hidden\">\n          <div className=\"flex items-center gap-3\">\n            <Link href={`/resumes/${resume._id}/edit`}>\n              <Button size=\"sm\" variant=\"outline\" className=\"gap-1.5\">\n                <ArrowLeft className=\"w-4 h-4\" /> Back to Editor\n              </Button>\n            </Link>\n            <h1 className=\"text-xl font-bold text-slate-900\">{resume.title}</h1>\n          </div>\n\n          <div className=\"flex items-center gap-3\">\n            {/* Live Template Toggle */}\n            <div className=\"flex items-center bg-slate-100 p-1 rounded-lg border border-slate-200\">\n              <button\n                type=\"button\"\n                onClick={() => setSelectedTemplate('MODERN_PROFESSIONAL')}\n                className={cn(\n                  'flex items-center gap-1.5 px-3 py-1.5 rounded-md text-xs font-semibold transition-colors',\n                  selectedTemplate === 'MODERN_PROFESSIONAL'\n                    ? 'bg-white text-blue-700 shadow-sm'\n                    : 'text-slate-600 hover:text-slate-900'\n                )}\n              >\n                <Layout className=\"w-3.5 h-3.5\" /> Modern\n              </button>\n              <button\n                type=\"button\"\n                onClick={() => setSelectedTemplate('ATS_CLASSIC')}\n                className={cn(\n                  'flex items-center gap-1.5 px-3 py-1.5 rounded-md text-xs font-semibold transition-colors',\n                  selectedTemplate === 'ATS_CLASSIC'\n                    ? 'bg-white text-blue-700 shadow-sm'\n                    : 'text-slate-600 hover:text-slate-900'\n                )}\n              >\n                <AlignLeft className=\"w-3.5 h-3.5\" /> ATS Classic\n              </button>\n            </div>\n\n            <Button size=\"sm\" variant=\"outline\" onClick={handleDownloadHtml} className=\"gap-1.5\">\n              <Download className=\"w-4 h-4\" /> Export HTML\n            </Button>\n\n            <Button size=\"sm\" onClick={handlePrint} className=\"gap-1.5\">\n              <Printer className=\"w-4 h-4\" /> Print / Save PDF\n            </Button>\n          </div>\n        </div>\n\n        {/* Rendered Document */}\n        <div className=\"p-4 sm:p-8 bg-slate-100 rounded-2xl border border-slate-200 shadow-inner flex justify-center\">\n          <ResumePreview resume={resume} templateOverride={selectedTemplate} />\n        </div>\n      </div>\n    </DashboardLayout>\n  );\n}\n","Description":"Create full Resume Preview and Export document page component","Overwrite":true,"TargetFile":"C:\\Users\\PRIYANKA\\.gemini\\antigravity\\scratch\\career-platform\\frontend\\app\\resumes\\[id]\\preview\\page.tsx","toolAction":"Writing frontend/app/resumes/[id]/preview/page.tsx","toolSummary":"Create resumes/[id]/preview/page.tsx"}}]}
{"step_index":251,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-13T13:13:36Z","content":"Created At: 2026-10-13T18:43:36+05:30\nCompleted At: 2026-10-13T18:43:37+05:30\nCreated file file:///C:/Users/PRIYANKA/.gemini/antigravity/scratch/career-platform/frontend/app/resumes/%5Bid%5D/preview/page.tsx with requested content.\nIf relevant, proactively run terminal commands to execute this code for the USER. Don't ask for permission."}
{"step_index":252,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-10-13T13:13:37Z","thinking":"Focusing on the consultation management page, the plan is to implement features for viewing consultations. These features will include filtering, search functionality, pagination, and status indicators. The page will also provide a cancel button for booked consultations. This functionality aims to give users full control over their scheduled consultations.\n\n\n","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"'use client';\n\nimport React, { useEffect, useState } from 'react';\nimport Link from 'next/link';\nimport { DashboardLayout } from '@/components/layout/DashboardLayout';\nimport { api } from '@/lib/api';\nimport { IBooking, BookingStatus } from '@/types';\nimport { Card, CardHeader, CardTitle, CardContent } from '@/components/ui/Card';\nimport { Button } from '@/components/ui/Button';\nimport { Badge } from '@/components/ui/Badge';\nimport { Input } from '@/components/ui/Input';\nimport { formatCurrency } from '@/lib/utils';\nimport {\n  CalendarCheck2,\n  Plus,\n  Search,\n  Video,\n  Clock,\n  XCircle,\n  ExternalLink,\n  ChevronLeft,\n  ChevronRight,\n  Loader2\n} from 'lucide-react';\n\nexport default function ConsultationsListPage() {\n  const [bookings, setBookings] = useState<IBooking[]>([]);\n  const [loading, setLoading] = useState(true);\n  const [page, setPage] = useState(1);\n  const [totalPages, setTotalPages] = useState(1);\n  const [total, setTotal] = useState(0);\n  const [search, setSearch] = useState('');\n  const [statusFilter, setStatusFilter] = useState<string>('');\n\n  useEffect(() => {\n    loadBookings();\n  }, [page, statusFilter]);\n\n  const loadBookings = async () => {\n    setLoading(true);\n    try {\n      const res = await api.getBookings(page, 5, statusFilter || undefined, search || undefined);\n      if (res?.data) {\n        setBookings(res.data);\n        if (res.pagination) {\n          setTotalPages(res.pagination.totalPages || 1);\n          setTotal(res.pagination.total || 0);\n        }\n      }\n    } catch (err) {\n      console.error('Failed to load bookings:', err);\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  const handleSearchSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    setPage(1);\n    loadBookings();\n  };\n\n  const handleCancel = async (id: string) => {\n    if (!confirm('Are you sure you want to cancel this consultation booking?')) return;\n    try {\n      await api.cancelBooking(id);\n      loadBookings();\n    } catch (err) {\n      console.error('Failed to cancel booking:', err);\n    }\n  };\n\n  const handlePayNow = async (bookingId: string) => {\n    try {\n      const res = await api.createCheckoutSession(bookingId);\n      if (res?.data?.checkoutUrl) {\n        window.location.href = res.data.checkoutUrl;\n      }\n    } catch (err) {\n      console.error('Failed to start checkout:', err);\n    }\n  };\n\n  return (\n    <DashboardLayout>\n      <div className=\"space-y-6\">\n        <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n          <div>\n            <h1 className=\"text-2xl font-bold tracking-tight text-slate-900\">My Consultations</h1>\n            <p className=\"text-sm text-slate-500 mt-1\">\n              Track your scheduled appointments, join video links, and manage upcoming career sessions.\n            </p>\n          </div>\n          <Link href=\"/consultations/book\">\n            <Button className=\"gap-2\">\n              <Plus className=\"w-4 h-4\" /> Book New Consultation\n            </Button>\n          </Link>\n        </div>\n\n        {/* Filters & Search Bar */}\n        <div className=\"flex flex-col sm:flex-row gap-3 items-center justify-between bg-white p-4 rounded-xl border border-slate-200\">\n          <form onSubmit={handleSearchSubmit} className=\"flex gap-2 w-full sm:w-80\">\n            <Input\n              value={search}\n              onChange={(e) => setSearch(e.target.value)}\n              placeholder=\"Search by agenda, name, email...\"\n              className=\"h-9 text-xs\"\n            />\n            <Button type=\"submit\" size=\"sm\" variant=\"secondary\" className=\"h-9 px-3\">\n              <Search className=\"w-3.5 h-3.5\" />\n            </Button>\n          </form>\n\n          {/* Status Filter */}\n          <div className=\"flex items-center gap-2 w-full sm:w-auto overflow-x-auto pb-1 sm:pb-0\">\n            <span className=\"text-xs font-semibold text-slate-500 whitespace-nowrap\">Filter Status:</span>\n            {['', 'PENDING_PAYMENT', 'CONFIRMED', 'CANCELLED', 'COMPLETED'].map((st) => (\n              <button\n                key={st}\n                onClick={() => {\n                  setStatusFilter(st);\n                  setPage(1);\n                }}\n                className={`px-2.5 py-1 rounded-lg text-xs font-medium whitespace-nowrap transition-colors ${\n                  statusFilter === st\n                    ? 'bg-blue-600 text-white font-semibold'\n                    : 'bg-slate-100 text-slate-600 hover:bg-slate-200'\n                }`}\n              >\n                {st === '' ? 'All' : st}\n              </button>\n            ))}\n          </div>\n        </div>\n\n        {/* Bookings Table / List */}\n        {loading ? (\n          <div className=\"h-64 flex items-center justify-center text-slate-400\">\n            <Loader2 className=\"w-8 h-8 animate-spin text-blue-600\" />\n          </div>\n        ) : bookings.length === 0 ? (\n          <Card className=\"py-16 text-center\">\n            <CalendarCheck2 className=\"w-12 h-12 text-slate-300 mx-auto mb-3\" />\n            <h3 className=\"text-base font-semibold text-slate-900\">No consultations found</h3>\n            <p className=\"text-xs text-slate-500 mt-1 max-w-sm mx-auto mb-4\">\n              You haven&apos;t booked any sessions matching your filter criteria.\n            </p>\n            <Link href=\"/consultations/book\">\n              <Button size=\"sm\">Browse Career Experts</Button>\n            </Link>\n          </Card>\n        ) : (\n          <div className=\"space-y-4\">\n            {bookings.map((booking) => {\n              const startDate = new Date(booking.startTime);\n              const isConfirmed = booking.status === 'CONFIRMED';\n              const isPending = booking.status === 'PENDING_PAYMENT';\n              const isCancelled = booking.status === 'CANCELLED';\n\n              return (\n                <Card key={booking._id} className=\"hover:border-slate-300 transition-all\">\n                  <CardContent className=\"p-5 flex flex-col md:flex-row items-start md:items-center justify-between gap-4\">\n                    <div className=\"space-y-1.5 flex-1 min-w-0\">\n                      <div className=\"flex flex-wrap items-center gap-2\">\n                        <span className=\"font-bold text-slate-900 text-base\">\n                          {booking.consultantId?.name || 'Expert Consultant'}\n                        </span>\n                        <Badge\n                          variant={\n                            isConfirmed ? 'success' : isPending ? 'warning' : isCancelled ? 'danger' : 'neutral'\n                          }\n                        >\n                          {booking.status}\n                        </Badge>\n                        <span className=\"text-xs font-semibold text-slate-500\">\n                          {formatCurrency(booking.amount, booking.currency)}\n                        </span>\n                      </div>\n\n                      <p className=\"text-xs text-slate-600 font-medium\">\n                        Agenda: <span className=\"font-normal\">{booking.agenda}</span>\n                      </p>\n\n                      <div className=\"flex flex-wrap items-center gap-4 text-xs text-slate-400 pt-1\">\n                        <span className=\"flex items-center gap-1\">\n                          <Clock className=\"w-3.5 h-3.5 text-slate-500\" />\n                          {startDate.toLocaleDateString('en-US', {\n                            weekday: 'short',\n                            month: 'short',\n                            day: 'numeric',\n                            year: 'numeric',\n                          })}{' '}\n                          at{' '}\n                          {startDate.toLocaleTimeString('en-US', {\n                            hour: '2-digit',\n                            minute: '2-digit',\n                          })}\n                        </span>\n                        <span>Duration: {booking.durationMinutes || 45} mins</span>\n                      </div>\n                    </div>\n\n                    <div className=\"flex items-center gap-2 self-end md:self-center\">\n                      {isPending && (\n                        <Button\n                          size=\"sm\"\n                          onClick={() => handlePayNow(booking._id)}\n                          className=\"gap-1.5 bg-emerald-600 hover:bg-emerald-700 text-white\"\n                        >\n                          Pay with Stripe\n                        </Button>\n                      )}\n\n                      {isConfirmed && booking.meetingUrl && (\n                        <a\n                          href={booking.meetingUrl}\n                          target=\"_blank\"\n                          rel=\"noreferrer\"\n                          className=\"inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-blue-50 text-blue-700 hover:bg-blue-100 text-xs font-semibold transition-colors\"\n                        >\n                          <Video className=\"w-3.5 h-3.5 text-blue-600\" /> Join Meeting\n                        </a>\n                      )}\n\n                      {!isCancelled && booking.status !== 'COMPLETED' && (\n                        <Button\n                          size=\"sm\"\n                          variant=\"ghost\"\n                          onClick={() => handleCancel(booking._id)}\n                          className=\"text-xs text-red-600 hover:bg-red-50\"\n                        >\n                          Cancel\n                        </Button>\n                      )}\n                    </div>\n                  </CardContent>\n                </Card>\n              );\n            })}\n\n            {/* Pagination Controls */}\n            <div className=\"flex items-center justify-between pt-4 border-t border-slate-200 text-xs text-slate-500\">\n              <span>\n                Showing page {page} of {totalPages} ({total} total bookings)\n              </span>\n              <div className=\"flex items-center gap-2\">\n                <Button\n                  size=\"sm\"\n                  variant=\"outline\"\n                  onClick={() => setPage((p) => Math.max(1, p - 1))}\n                  disabled={page <= 1}\n                  className=\"h-8 px-2.5\"\n                >\n                  <ChevronLeft className=\"w-4 h-4\" />\n                </Button>\n                <Button\n                  size=\"sm\"\n                  variant=\"outline\"\n                  onClick={() => setPage((p) => Math.min(totalPages, p + 1))}\n                  disabled={page >= totalPages}\n                  className=\"h-8 px-2.5\"\n                >\n                  <ChevronRight className=\"w-4 h-4\" />\n                </Button>\n              </div>\n            </div>\n          </div>\n        )}\n      </div>\n    </DashboardLayout>\n  );\n}\n","Description":"Create server-paginated consultations management page component","Overwrite":true,"TargetFile":"C:\\Users\\PRIYANKA\\.gemini\\antigravity\\scratch\\career-platform\\frontend\\app\\consultations\\page.tsx","toolAction":"Writing frontend/app/consultations/page.tsx","toolSummary":"Create consultations/page.tsx"}}]}
{"step_index":253,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-13T13:14:00Z","content":"Created At: 2026-10-13T18:44:00+05:30\nCompleted At: 2026-10-13T18:44:00+05:30\nCreated file file:///C:/Users/PRIYANKA/.gemini/antigravity/scratch/career-platform/frontend/app/consultations/page.tsx with requested content.\nIf relevant, proactively run terminal commands to execute this code for the USER. Don't ask for permission."}
{"step_index":254,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-10-13T13:14:00Z","thinking":"Initial focus is on constructing the booking flow UI component. The component requires a consultant directory browsing feature and subsequent selection. Next, the user will choose a date, with available time slots fetched from the backend. The user input form will collect booking details. Upon submission, the backend will handle booking validation and state, calling the payment system to generate a checkout session, followed by a redirect to the payment system.\n\n\n","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"'use client';\n\nimport React, { useEffect, useState } from 'react';\nimport { useRouter } from 'next/navigation';\nimport { DashboardLayout } from '@/components/layout/DashboardLayout';\nimport { api } from '@/lib/api';\nimport { IConsultant, IUser } from '@/types';\nimport { Card, CardHeader, CardTitle, CardDescription, CardContent } from '@/components/ui/Card';\nimport { Button } from '@/components/ui/Button';\nimport { Input } from '@/components/ui/Input';\nimport { Badge } from '@/components/ui/Badge';\nimport { formatCurrency } from '@/lib/utils';\nimport {\n  Calendar,\n  Clock,\n  User,\n  Mail,\n  Phone,\n  CheckCircle,\n  Briefcase,\n  AlertCircle,\n  Loader2,\n  ArrowRight\n} from 'lucide-react';\nimport { cn } from '@/lib/utils';\n\nexport default function BookConsultationPage() {\n  const router = useRouter();\n\n  const [consultants, setConsultants] = useState<IConsultant[]>([]);\n  const [selectedConsultant, setSelectedConsultant] = useState<IConsultant | null>(null);\n  const [selectedDate, setSelectedDate] = useState<string>('');\n  const [availableSlots, setAvailableSlots] = useState<Array<{ startTime: string; endTime: string; isAvailable: boolean }>>([]);\n  const [selectedSlot, setSelectedSlot] = useState<string | null>(null);\n\n  // Booking details\n  const [userName, setUserName] = useState('');\n  const [userEmail, setUserEmail] = useState('');\n  const [userPhone, setUserPhone] = useState('');\n  const [agenda, setAgenda] = useState('');\n\n  const [loadingConsultants, setLoadingConsultants] = useState(true);\n  const [loadingSlots, setLoadingSlots] = useState(false);\n  const [isSubmitting, setIsSubmitting] = useState(false);\n  const [error, setError] = useState<string | null>(null);\n\n  // Initialize date to tomorrow (YYYY-MM-DD)\n  useEffect(() => {\n    const tomorrow = new Date();\n    tomorrow.setDate(tomorrow.getDate() + 1);\n    setSelectedDate(tomorrow.toISOString().split('T')[0]);\n\n    // Load current user profile for prefilling\n    api.getMe()\n      .then((res) => {\n        if (res?.data?.user) {\n          const u: IUser = res.data.user;\n          setUserName(u.name || '');\n          setUserEmail(u.email || '');\n          setPhoneIfAny(u.profile?.phone);\n        }\n      })\n      .catch(() => {});\n\n    // Load active consultants\n    api.getConsultants()\n      .then((res) => {\n        if (res?.data?.consultants) {\n          setConsultants(res.data.consultants);\n          if (res.data.consultants.length > 0) {\n            setSelectedConsultant(res.data.consultants[0]);\n          }\n        }\n      })\n      .catch((err) => console.error('Failed to load consultants:', err))\n      .finally(() => setLoadingConsultants(false));\n  }, []);\n\n  const setPhoneIfAny = (p?: string) => {\n    if (p) setUserPhone(p);\n  };\n\n  // Fetch availability when consultant or date changes\n  useEffect(() => {\n    if (selectedConsultant && selectedDate) {\n      setLoadingSlots(true);\n      setSelectedSlot(null);\n      api.getConsultantAvailability(selectedConsultant._id, selectedDate)\n        .then((res) => {\n          if (res?.data?.slots) {\n            setAvailableSlots(res.data.slots);\n          }\n        })\n        .catch((err) => console.error('Failed to load availability:', err))\n        .finally(() => setLoadingSlots(false));\n    }\n  }, [selectedConsultant, selectedDate]);\n\n  const handleBookAndPay = async (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!selectedConsultant || !selectedSlot) return;\n\n    setError(null);\n    setIsSubmitting(true);\n\n    try {\n      // 1. Create booking in PENDING_PAYMENT\n      const bookingRes = await api.createBooking({\n        consultantId: selectedConsultant._id,\n        startTime: selectedSlot,\n        userName,\n        userEmail,\n        userPhone,\n        agenda,\n      });\n\n      const bookingId = bookingRes?.data?.booking?._id;\n      if (!bookingId) {\n        throw new Error('Failed to create booking reservation');\n      }\n\n      // 2. Create Stripe Checkout Session\n      const checkoutRes = await api.createCheckoutSession(bookingId);\n      const checkoutUrl = checkoutRes?.data?.checkoutUrl;\n\n      if (checkoutUrl) {\n        window.location.href = checkoutUrl;\n      } else {\n        router.push(`/consultations`);\n      }\n    } catch (err: any) {\n      setError(err.message || 'Booking reservation failed. Please try another time.');\n      setIsSubmitting(false);\n    }\n  };\n\n  return (\n    <DashboardLayout>\n      <div className=\"max-w-4xl mx-auto space-y-8\">\n        <div>\n          <h1 className=\"text-2xl font-bold tracking-tight text-slate-900\">Book an Expert Consultation</h1>\n          <p className=\"text-sm text-slate-500 mt-1\">\n            Connect 1-on-1 with Staff/Principal industry leaders for mock interviews, career roadmapping, and offer negotiation.\n          </p>\n        </div>\n\n        {error && (\n          <div className=\"p-4 rounded-xl bg-red-50 border border-red-200 text-red-700 text-sm flex items-center gap-2\">\n            <AlertCircle className=\"w-5 h-5 flex-shrink-0\" />\n            <span>{error}</span>\n          </div>\n        )}\n\n        <form onSubmit={handleBookAndPay} className=\"space-y-8\">\n          {/* Step 1: Select Consultant */}\n          <Card>\n            <CardHeader>\n              <CardTitle className=\"text-base flex items-center gap-2\">\n                <span className=\"w-6 h-6 rounded-full bg-blue-600 text-white text-xs flex items-center justify-center font-bold\">1</span>\n                Select a Career Expert\n              </CardTitle>\n              <CardDescription>Choose from our vetted roster of industry veterans</CardDescription>\n            </CardHeader>\n            <CardContent>\n              {loadingConsultants ? (\n                <div className=\"h-28 flex items-center justify-center text-slate-400\">\n                  <Loader2 className=\"w-6 h-6 animate-spin text-blue-600\" />\n                </div>\n              ) : (\n                <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n                  {consultants.map((c) => {\n                    const isSelected = selectedConsultant?._id === c._id;\n                    return (\n                      <div\n                        key={c._id}\n                        onClick={() => setSelectedConsultant(c)}\n                        className={cn(\n                          'p-5 rounded-xl border-2 cursor-pointer transition-all flex flex-col justify-between',\n                          isSelected\n                            ? 'border-blue-600 bg-blue-50/40 shadow-sm'\n                            : 'border-slate-200 hover:border-slate-300 bg-white'\n                        )}\n                      >\n                        <div>\n                          <div className=\"flex items-center justify-between mb-3\">\n                            <span className=\"font-bold text-slate-900 text-base\">{c.name}</span>\n                            <span className=\"text-xs font-bold text-blue-600\">\n                              {formatCurrency(c.hourlyRate)}\n                            </span>\n                          </div>\n                          <p className=\"text-xs text-slate-500 line-clamp-2 mb-3\">{c.title}</p>\n                          <div className=\"flex flex-wrap gap-1\">\n                            {c.expertise.slice(0, 3).map((exp, idx) => (\n                              <span key={idx} className=\"px-2 py-0.5 rounded bg-slate-100 text-[10px] text-slate-600 font-medium\">\n                                {exp}\n                              </span>\n                            ))}\n                          </div>\n                        </div>\n\n                        <div className=\"mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs text-slate-400\">\n                          <span>{c.durationMinutes} min session</span>\n                          {isSelected && <span className=\"font-bold text-blue-600\">Selected</span>}\n                        </div>\n                      </div>\n                    );\n                  })}\n                </div>\n              )}\n            </CardContent>\n          </Card>\n\n          {/* Step 2: Choose Date & Time Slot */}\n          <Card>\n            <CardHeader>\n              <CardTitle className=\"text-base flex items-center gap-2\">\n                <span className=\"w-6 h-6 rounded-full bg-blue-600 text-white text-xs flex items-center justify-center font-bold\">2</span>\n                Choose Date & Available Slot\n              </CardTitle>\n              <CardDescription>Real-time slot availability for {selectedConsultant?.name}</CardDescription>\n            </CardHeader>\n            <CardContent className=\"space-y-4\">\n              <div className=\"max-w-xs\">\n                <Input\n                  label=\"Select Consultation Date\"\n                  type=\"date\"\n                  value={selectedDate}\n                  min={new Date().toISOString().split('T')[0]}\n                  onChange={(e) => setSelectedDate(e.target.value)}\n                />\n              </div>\n\n              <div>\n                <label className=\"block text-xs font-semibold text-slate-700 mb-2\">Available Time Slots (UTC)</label>\n                {loadingSlots ? (\n                  <div className=\"p-6 text-center text-xs text-slate-400\">Loading available times...</div>\n                ) : availableSlots.length === 0 ? (\n                  <p className=\"text-xs text-amber-600 bg-amber-50 p-3 rounded-lg border border-amber-200\">\n                    No open consultation slots available for this date. Please select another day.\n                  </p>\n                ) : (\n                  <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-2.5\">\n                    {availableSlots.map((slot) => {\n                      const timeStr = new Date(slot.startTime).toLocaleTimeString([], {\n                        hour: '2-digit',\n                        minute: '2-digit',\n                      });\n                      const isSelected = selectedSlot === slot.startTime;\n\n                      return (\n                        <button\n                          key={slot.startTime}\n                          type=\"button\"\n                          disabled={!slot.isAvailable}\n                          onClick={() => setSelectedSlot(slot.startTime)}\n                          className={cn(\n                            'p-3 rounded-xl border text-xs font-semibold transition-all flex items-center justify-center gap-2',\n                            !slot.isAvailable && 'opacity-40 cursor-not-allowed bg-slate-50 border-slate-200 text-slate-400',\n                            slot.isAvailable && !isSelected && 'border-slate-200 bg-white hover:border-blue-400 hover:bg-blue-50 text-slate-800',\n                            isSelected && 'border-blue-600 bg-blue-600 text-white shadow-sm'\n                          )}\n                        >\n                          <Clock className=\"w-3.5 h-3.5\" />\n                          {timeStr}\n                        </button>\n                      );\n                    })}\n                  </div>\n                )}\n              </div>\n            </CardContent>\n          </Card>\n\n          {/* Step 3: Attendee Details & Agenda */}\n          <Card>\n            <CardHeader>\n              <CardTitle className=\"text-base flex items-center gap-2\">\n                <span className=\"w-6 h-6 rounded-full bg-blue-600 text-white text-xs flex items-center justify-center font-bold\">3</span>\n                Session Agenda & Details\n              </CardTitle>\n              <CardDescription>Your information for the calendar invitation and video link</CardDescription>\n            </CardHeader>\n            <CardContent className=\"space-y-4\">\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n                <Input\n                  label=\"Your Name\"\n                  value={userName}\n                  onChange={(e) => setUserName(e.target.value)}\n                  placeholder=\"e.g. Alice Johnson\"\n                  required\n                />\n                <Input\n                  label=\"Your Email\"\n                  type=\"email\"\n                  value={userEmail}\n                  onChange={(e) => setUserEmail(e.target.value)}\n                  placeholder=\"alice@example.com\"\n                  required\n                />\n              </div>\n\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n                <Input\n                  label=\"Phone Number (Optional)\"\n                  value={userPhone}\n                  onChange={(e) => setUserPhone(e.target.value)}\n                  placeholder=\"+1 (555) 0199\"\n                />\n                <div className=\"flex flex-col justify-end\">\n                  <div className=\"p-3 bg-slate-50 border border-slate-200 rounded-lg text-xs text-slate-600\">\n                    Total Due: <strong className=\"text-slate-900 text-sm ml-1\">{formatCurrency(selectedConsultant?.hourlyRate || 0)}</strong>\n                  </div>\n                </div>\n              </div>\n\n              <div>\n                <label className=\"block text-sm font-medium text-slate-700 mb-1.5\">Meeting Agenda & Goals</label>\n                <textarea\n                  rows={3}\n                  value={agenda}\n                  onChange={(e) => setAgenda(e.target.value)}\n                  placeholder=\"Outline what you want to achieve (e.g. Meta L6 system design mock interview, compensation negotiation strategy for Staff offer...)\"\n                  className=\"w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 placeholder:text-slate-400 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500\"\n                  required\n                />\n              </div>\n            </CardContent>\n          </Card>\n\n          <div className=\"flex justify-end pt-2\">\n            <Button\n              type=\"submit\"\n              size=\"lg\"\n              isLoading={isSubmitting}\n              disabled={!selectedSlot || !agenda.trim() || !userName.trim() || !userEmail.trim()}\n              className=\"gap-2 shadow-lg shadow-blue-500/20\"\n            >\n              Proceed to Stripe Checkout <ArrowRight className=\"w-5 h-5 ml-1\" />\n            </Button>\n          </div>\n        </form>\n      </div>\n    </DashboardLayout>\n  );\n}\n","Description":"Create full interactive consultation booking flow with Stripe redirect","Overwrite":true,"TargetFile":"C:\\Users\\PRIYANKA\\.gemini\\antigravity\\scratch\\career-platform\\frontend\\app\\consultations\\book\\page.tsx","toolAction":"Writing frontend/app/consultations/book/page.tsx","toolSummary":"Create consultations/book/page.tsx"}}]}
