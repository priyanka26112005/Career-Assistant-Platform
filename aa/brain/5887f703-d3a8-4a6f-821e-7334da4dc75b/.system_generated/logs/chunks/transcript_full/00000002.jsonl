{"step_index":121,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-10-13T12:51:13Z","thinking":"Payment controller construction commences, focusing on `createCheckoutSession`. The authentication requirement necessitates user verification. Input validation confirms the `bookingId` corresponds to an existing, user-owned booking in a \"PENDING_PAYMENT\" state.\n\nAdditionally, consultant data is fetched for name and price verification. Real Stripe key presence will determine live mode.\n\n\nThe `createCheckoutSession` function will either create a live Stripe session if a real key is available or generate a mock session for testing; this is crucial for development. The function then constructs and returns the `checkoutUrl` along with the `sessionId`. The `handleWebhook` function processes incoming Stripe webhooks to update the system based on payment events. It handles idempotency to prevent duplicate processing of webhook events.\n\nIf a `checkout.session.completed` event is received, the handler updates the payment status, transitions the booking, and integrates with calendar and email adapters for scheduling and confirmation. Error handling will be implemented for the calendar adapter, to manage scheduling failures.\n\n\n","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"import { Request, Response, NextFunction } from 'express';\nimport Stripe from 'stripe';\nimport { Types } from 'mongoose';\nimport { Payment } from './payment.model';\nimport { Booking } from '../bookings/booking.model';\nimport { Consultant } from '../consultants/consultant.model';\nimport { getCalendarAdapter } from '../../integrations/calendar';\nimport { getEmailAdapter } from '../../integrations/email';\nimport { env } from '../../config/env';\nimport { logger } from '../../utils/logger';\nimport { BadRequestError, NotFoundError, UnauthorizedError, ForbiddenError } from '../../utils/errors';\n\nlet stripeClient: Stripe | null = null;\nif (env.STRIPE_SECRET_KEY && !env.STRIPE_SECRET_KEY.includes('placeholder')) {\n  stripeClient = new Stripe(env.STRIPE_SECRET_KEY, {\n    apiVersion: '2025-01-27.acacia' as any\n  });\n}\n\nexport const createCheckoutSession = async (req: Request, res: Response, next: NextFunction): Promise<void> => {\n  try {\n    if (!req.user) throw new UnauthorizedError();\n    const { bookingId } = req.body;\n\n    if (!bookingId) {\n      throw new BadRequestError('bookingId is required');\n    }\n\n    const booking = await Booking.findById(bookingId).populate('consultantId');\n    if (!booking) {\n      throw new NotFoundError('Booking record not found');\n    }\n\n    if (booking.userId.toString() !== req.user.userId) {\n      throw new ForbiddenError('You do not have permission to pay for this booking');\n    }\n\n    if (booking.status !== 'PENDING_PAYMENT') {\n      throw new BadRequestError(`Cannot initiate payment for booking in \"${booking.status}\" status`);\n    }\n\n    const consultant = booking.consultantId as any;\n    const consultantName = consultant?.name || 'Career Consultant';\n\n    let checkoutUrl = '';\n    let sessionId = '';\n\n    if (stripeClient) {\n      // Real Stripe Checkout Session\n      const session = await stripeClient.checkout.sessions.create({\n        payment_method_types: ['card'],\n        line_items: [\n          {\n            price_data: {\n              currency: booking.currency || 'usd',\n              product_data: {\n                name: `Consultation with ${consultantName}`,\n                description: `45-min Career Coaching & Advisory (${booking.agenda.slice(0, 80)})`\n              },\n              unit_amount: booking.amount // Strictly backend calculated\n            },\n            quantity: 1\n          }\n        ],\n        mode: 'payment',\n        success_url: `${env.FRONTEND_URL}/payment/success?session_id={CHECKOUT_SESSION_ID}`,\n        cancel_url: `${env.FRONTEND_URL}/payment/cancel?booking_id=${booking._id}`,\n        client_reference_id: booking._id.toString(),\n        metadata: {\n          bookingId: booking._id.toString(),\n          userId: req.user.userId\n        }\n      });\n\n      sessionId = session.id;\n      checkoutUrl = session.url || '';\n    } else {\n      // Local development fallback session\n      sessionId = `cs_test_mock_${booking._id}_${Date.now()}`;\n      checkoutUrl = `${env.FRONTEND_URL}/payment/success?session_id=${sessionId}`;\n      logger.info(`[MockStripe (Dev Fallback)] Generated mock checkout session ${sessionId}`);\n    }\n\n    // Persist Payment document\n    await Payment.findOneAndUpdate(\n      { bookingId: booking._id },\n      {\n        bookingId: booking._id,\n        userId: new Types.ObjectId(req.user.userId),\n        stripeSessionId: sessionId,\n        amount: booking.amount,\n        currency: booking.currency || 'usd',\n        status: 'PENDING'\n      },\n      { upsert: true, new: true }\n    );\n\n    res.status(200).json({\n      success: true,\n      data: {\n        sessionId,\n        checkoutUrl\n      }\n    });\n  } catch (err) {\n    next(err);\n  }\n};\n\nexport const handleWebhook = async (req: Request, res: Response, next: NextFunction): Promise<void> => {\n  try {\n    const sig = req.headers['stripe-signature'] as string;\n    let event: Stripe.Event;\n\n    if (stripeClient && env.STRIPE_WEBHOOK_SECRET && !env.STRIPE_WEBHOOK_SECRET.includes('placeholder')) {\n      if (!sig) {\n        throw new BadRequestError('Missing stripe-signature header');\n      }\n      try {\n        event = stripeClient.webhooks.constructEvent(req.body, sig, env.STRIPE_WEBHOOK_SECRET);\n      } catch (err: any) {\n        logger.error(`Webhook signature verification failed: ${err.message}`);\n        res.status(400).send(`Webhook Error: ${err.message}`);\n        return;\n      }\n    } else {\n      // Development mock webhook simulation or test runner payload\n      event = typeof req.body === 'string' ? JSON.parse(req.body) : req.body;\n      logger.info(`[PaymentWebhook] Processing event in dev/test mode: ${event?.type}`);\n    }\n\n    if (!event || !event.type) {\n      throw new BadRequestError('Invalid webhook event payload');\n    }\n\n    const eventId = event.id || `evt_${Date.now()}`;\n\n    if (event.type === 'checkout.session.completed') {\n      const session = event.data.object as Stripe.Checkout.Session;\n      const sessionId = session.id;\n      const bookingId = session.metadata?.bookingId || session.client_reference_id;\n\n      // Locate payment record\n      let payment = await Payment.findOne({\n        $or: [{ stripeSessionId: sessionId }, { bookingId: bookingId ? new Types.ObjectId(bookingId) : undefined }]\n      });\n\n      if (!payment && bookingId) {\n        // Fallback create if not initialized\n        const booking = await Booking.findById(bookingId);\n        if (booking) {\n          payment = new Payment({\n            bookingId: booking._id,\n            userId: booking.userId,\n            stripeSessionId: sessionId,\n            amount: booking.amount,\n            status: 'PENDING'\n          });\n          await payment.save();\n        }\n      }\n\n      if (!payment) {\n        logger.warn(`[PaymentWebhook] Payment record not found for session ${sessionId}`);\n        res.status(200).json({ received: true, note: 'Payment record not found' });\n        return;\n      }\n\n      // STRICT IDEMPOTENCY CHECK\n      if (payment.processedWebhookEvents.includes(eventId)) {\n        logger.info(`[PaymentWebhook] Idempotent skip: Event ${eventId} was already processed for payment ${payment._id}`);\n        res.status(200).json({ received: true, duplicate: true });\n        return;\n      }\n\n      // Mark payment as succeeded\n      payment.status = 'SUCCEEDED';\n      if (session.payment_intent) {\n        payment.stripePaymentIntentId = String(session.payment_intent);\n      }\n      payment.processedWebhookEvents.push(eventId);\n      await payment.save();\n\n      // Transition booking state to CONFIRMED\n      const booking = await Booking.findById(payment.bookingId).populate('consultantId');\n      if (booking) {\n        booking.status = 'CONFIRMED';\n\n        const consultant = booking.consultantId as any;\n        const consultantEmail = consultant?.email || 'consultant@careerplatform.com';\n        const consultantName = consultant?.name || 'Career Consultant';\n\n        // Trigger Google Calendar integration\n        try {\n          const calendarAdapter = getCalendarAdapter();\n          const calResult = await calendarAdapter.createEvent({\n            summary: `Career Consultation: ${booking.userName} & ${consultantName}`,\n            description: `Agenda: ${booking.agenda}`,\n            startTime: booking.startTime,\n            endTime: booking.endTime,\n            attendeeEmail: booking.userEmail,\n            consultantEmail\n          });\n\n          booking.calendarEventId = calResult.eventId;\n          booking.meetingUrl = calResult.meetingUrl;\n          booking.calendarStatus = 'SCHEDULED';\n        } catch (calErr) {\n          logger.error('[PaymentWebhook] Google Calendar creation failed, preserving confirmed payment:', calErr);\n          booking.calendarStatus = 'FAILED';\n        }\n\n        // Trigger Email Notification integration\n        try {\n          const emailAdapter = getEmailAdapter();\n          await emailAdapter.sendBookingConfirmation({\n            to: booking.userEmail,\n            userName: booking.userName,\n            consultantName,\n            dateStr: booking.startTime.toISOString().split('T')[0],\n            timeStr: booking.startTime.toISOString().split('T')[1].slice(0, 5),\n            meetingUrl: booking.meetingUrl,\n            bookingId: booking._id.toString(),\n            agenda: booking.agenda\n          });\n\n          booking.emailStatus = 'SENT';\n        } catch (emailErr) {\n          logger.error('[PaymentWebhook] Confirmation email delivery failed, preserving confirmed payment:', emailErr);\n          booking.emailStatus = 'FAILED';\n        }\n\n        await booking.save();\n        logger.info(`[PaymentWebhook] Booking ${booking._id} transitioned to CONFIRMED`);\n      }\n    } else if (event.type === 'payment_intent.payment_failed') {\n      const paymentIntent = event.data.object as Stripe.PaymentIntent;\n      const payment = await Payment.findOne({ stripePaymentIntentId: paymentIntent.id });\n      if (payment) {\n        payment.status = 'FAILED';\n        payment.processedWebhookEvents.push(eventId);\n        await payment.save();\n\n        await Booking.findByIdAndUpdate(payment.bookingId, { status: 'PAYMENT_FAILED' });\n      }\n    }\n\n    res.status(200).json({ received: true });\n  } catch (err) {\n    next(err);\n  }\n};\n\nexport const getPaymentStatus = async (req: Request, res: Response, next: NextFunction): Promise<void> => {\n  try {\n    const { bookingId } = req.params;\n    const { sessionId } = req.query;\n\n    let payment;\n    if (bookingId && bookingId !== 'undefined') {\n      payment = await Payment.findOne({ bookingId: new Types.ObjectId(bookingId) });\n    } else if (sessionId) {\n      payment = await Payment.findOne({ stripeSessionId: String(sessionId) });\n    }\n\n    if (!payment) {\n      throw new NotFoundError('Payment information not found');\n    }\n\n    const booking = await Booking.findById(payment.bookingId).populate('consultantId', 'name title email avatarUrl');\n\n    res.status(200).json({\n      success: true,\n      data: {\n        paymentStatus: payment.status,\n        amount: payment.amount,\n        currency: payment.currency,\n        booking\n      }\n    });\n  } catch (err) {\n    next(err);\n  }\n};\n","Description":"Create Payment controllers with Stripe Checkout, webhook idempotency, and failure isolation","Overwrite":true,"TargetFile":"C:\\Users\\PRIYANKA\\.gemini\\antigravity\\scratch\\career-platform\\backend\\src\\modules\\payments\\payment.controller.ts","toolAction":"Writing backend/src/modules/payments/payment.controller.ts","toolSummary":"Create payment.controller.ts"}}]}
