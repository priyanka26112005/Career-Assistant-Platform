{"step_index":107,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-10-13T12:50:04Z","thinking":"Initial focus is on defining the Booking module's data structure. The model will encompass user and consultant identifiers, user contact information, the meeting agenda, and scheduling details including start/end times and duration. Financial information like the booking amount (in cents) and the currency will also be included.\n\n\n","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"import mongoose, { Document, Schema, Types } from 'mongoose';\n\nexport type BookingStatus =\n  | 'PENDING_PAYMENT'\n  | 'PAYMENT_FAILED'\n  | 'PAID'\n  | 'CONFIRMED'\n  | 'CANCELLED'\n  | 'COMPLETED';\n\nexport type CalendarSyncStatus = 'NOT_SCHEDULED' | 'SCHEDULED' | 'FAILED';\nexport type EmailSyncStatus = 'NOT_SENT' | 'SENT' | 'FAILED';\n\nexport interface IBooking extends Document {\n  _id: Types.ObjectId;\n  userId: Types.ObjectId;\n  consultantId: Types.ObjectId;\n  userName: string;\n  userEmail: string;\n  userPhone?: string;\n  agenda: string;\n  startTime: Date;\n  endTime: Date;\n  durationMinutes: number;\n  amount: number; // in cents\n  currency: string;\n  status: BookingStatus;\n  calendarEventId?: string;\n  meetingUrl?: string;\n  calendarStatus: CalendarSyncStatus;\n  emailStatus: EmailSyncStatus;\n  createdAt: Date;\n  updatedAt: Date;\n}\n\nconst BookingSchema = new Schema<IBooking>({\n  userId: { type: Schema.Types.ObjectId, ref: 'User', required: true, index: true },\n  consultantId: { type: Schema.Types.ObjectId, ref: 'Consultant', required: true, index: true },\n  userName: { type: String, required: true, trim: true },\n  userEmail: { type: String, required: true, lowercase: true, trim: true },\n  userPhone: { type: String, default: '' },\n  agenda: { type: String, required: true },\n  startTime: { type: Date, required: true, index: true },\n  endTime: { type: Date, required: true },\n  durationMinutes: { type: Number, required: true, default: 45 },\n  amount: { type: Number, required: true },\n  currency: { type: String, default: 'usd', lowercase: true },\n  status: {\n    type: String,\n    enum: ['PENDING_PAYMENT', 'PAYMENT_FAILED', 'PAID', 'CONFIRMED', 'CANCELLED', 'COMPLETED'],\n    default: 'PENDING_PAYMENT',\n    index: true\n  },\n  calendarEventId: { type: String },\n  meetingUrl: { type: String },\n  calendarStatus: {\n    type: String,\n    enum: ['NOT_SCHEDULED', 'SCHEDULED', 'FAILED'],\n    default: 'NOT_SCHEDULED'\n  },\n  emailStatus: {\n    type: String,\n    enum: ['NOT_SENT', 'SENT', 'FAILED'],\n    default: 'NOT_SENT'\n  }\n}, {\n  timestamps: true\n});\n\n// Indexes for conflict prevention and rapid lookup\nBookingSchema.index({ consultantId: 1, startTime: 1, status: 1 });\nBookingSchema.index({ userId: 1, createdAt: -1 });\n\nexport const Booking = mongoose.model<IBooking>('Booking', BookingSchema);\n","Description":"Create Booking Mongoose schema with status indexes","Overwrite":true,"TargetFile":"C:\\Users\\PRIYANKA\\.gemini\\antigravity\\scratch\\career-platform\\backend\\src\\modules\\bookings\\booking.model.ts","toolAction":"Writing backend/src/modules/bookings/booking.model.ts","toolSummary":"Create booking.model.ts"}}]}
