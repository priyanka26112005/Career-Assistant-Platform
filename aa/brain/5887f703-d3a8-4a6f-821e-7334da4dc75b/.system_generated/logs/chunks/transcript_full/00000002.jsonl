{"step_index":129,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-10-13T12:51:57Z","thinking":"Considering the structure of `backend/src/app.ts`, initial requirements include security middlewares such as CORS, Helmet, and cookie parsing. Special consideration for the `/api/payments/webhook` route necessitates raw body parsing, differing from other routes. Health check endpoints and comprehensive logging with Morgan are also essential.\n\n\n","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"import express, { Application, Request, Response, NextFunction } from 'express';\nimport cors from 'cors';\nimport helmet from 'helmet';\nimport cookieParser from 'cookie-parser';\nimport morgan from 'morgan';\nimport swaggerUi from 'swagger-ui-express';\n\nimport { env } from './config/env';\nimport { errorHandler } from './middleware/errorHandler';\nimport { NotFoundError } from './utils/errors';\n\n// Route imports\nimport authRoutes from './modules/auth/auth.routes';\nimport userRoutes from './modules/users/user.routes';\nimport chatRoutes from './modules/chat/chat.routes';\nimport resumeRoutes from './modules/resumes/resume.routes';\nimport consultantRoutes from './modules/consultants/consultant.routes';\nimport bookingRoutes from './modules/bookings/booking.routes';\nimport paymentRoutes from './modules/payments/payment.routes';\nimport dashboardRoutes from './modules/dashboard/dashboard.routes';\n\nconst app: Application = express();\n\n// Security and utility middleware\napp.use(helmet({\n  contentSecurityPolicy: false // Allows Swagger UI and local development\n}));\n\napp.use(cors({\n  origin: [env.FRONTEND_URL, 'http://localhost:3000'],\n  credentials: true,\n  methods: ['GET', 'POST', 'PUT', 'PATCH', 'DELETE', 'OPTIONS'],\n  allowedHeaders: ['Content-Type', 'Authorization', 'stripe-signature']\n}));\n\napp.use(cookieParser(env.COOKIE_SECRET));\n\nif (env.NODE_ENV !== 'test') {\n  app.use(morgan('dev'));\n}\n\n// NOTE: Stripe webhook needs raw body, handled before or with conditional json parsing\napp.use((req, res, next) => {\n  if (req.originalUrl === '/api/payments/webhook') {\n    express.raw({ type: 'application/json' })(req, res, next);\n  } else {\n    express.json({ limit: '10mb' })(req, res, next);\n  }\n});\napp.use(express.urlencoded({ extended: true, limit: '10mb' }));\n\n// Health Check Endpoints\nconst healthHandler = (req: Request, res: Response) => {\n  res.status(200).json({\n    status: 'healthy',\n    timestamp: new Date().toISOString(),\n    environment: env.NODE_ENV,\n    version: '1.0.0',\n    service: 'AI Career and Consultation Platform Backend'\n  });\n};\napp.get('/health', healthHandler);\napp.get('/api/health', healthHandler);\n\n// OpenAPI / Swagger Documentation\nconst swaggerDocument = {\n  openapi: '3.0.0',\n  info: {\n    title: 'AI-Powered Career and Consultation Platform API',\n    version: '1.0.0',\n    description: 'RESTful API for AI resume builder, career assistant, and consultation booking platform'\n  },\n  servers: [\n    { url: `http://localhost:${env.PORT}`, description: 'Local Development Server' }\n  ],\n  paths: {\n    '/api/auth/register': { post: { summary: 'Register a new user' } },\n    '/api/auth/login': { post: { summary: 'Login user and issue JWT' } },\n    '/api/auth/logout': { post: { summary: 'Logout and clear auth cookie' } },\n    '/api/auth/me': { get: { summary: 'Get current authenticated user' } },\n    '/api/users/profile': {\n      get: { summary: 'Get user profile' },\n      patch: { summary: 'Update user profile' }\n    },\n    '/api/chat/sessions': {\n      get: { summary: 'List user chat sessions' },\n      post: { summary: 'Create new chat session' }\n    },\n    '/api/chat/sessions/{sessionId}/messages': {\n      post: { summary: 'Send message and receive AI career advice' }\n    },\n    '/api/resumes': {\n      get: { summary: 'List user resumes' },\n      post: { summary: 'Create new structured resume' }\n    },\n    '/api/resumes/{id}/generate': {\n      post: { summary: 'AI generate/refine specific resume section' }\n    },\n    '/api/resumes/{id}/export': {\n      get: { summary: 'Export resume in chosen template' }\n    },\n    '/api/consultants': {\n      get: { summary: 'List active consultants' }\n    },\n    '/api/bookings': {\n      get: { summary: 'List user bookings with pagination and filters' },\n      post: { summary: 'Create new booking reservation' }\n    },\n    '/api/payments/checkout': {\n      post: { summary: 'Initiate Stripe Checkout session' }\n    },\n    '/api/payments/webhook': {\n      post: { summary: 'Process Stripe webhook notifications' }\n    },\n    '/api/dashboard': {\n      get: { summary: 'Retrieve user aggregated dashboard metrics' }\n    }\n  }\n};\n\napp.use('/api/docs', swaggerUi.serve, swaggerUi.setup(swaggerDocument));\n\n// Mount Modules\napp.use('/api/auth', authRoutes);\napp.use('/api/users', userRoutes);\napp.use('/api/chat', chatRoutes);\napp.use('/api/resumes', resumeRoutes);\napp.use('/api/consultants', consultantRoutes);\napp.use('/api/bookings', bookingRoutes);\napp.use('/api/payments', paymentRoutes);\napp.use('/api/dashboard', dashboardRoutes);\n\n// 404 Catch-All\napp.use((req: Request, res: Response, next: NextFunction) => {\n  next(new NotFoundError(`Endpoint not found: [${req.method}] ${req.originalUrl}`));\n});\n\n// Centralized Error Handler\napp.use(errorHandler);\n\nexport default app;\n","Description":"Create main Express app with route mounting, health checks, Swagger, and error handling","Overwrite":true,"TargetFile":"C:\\Users\\PRIYANKA\\.gemini\\antigravity\\scratch\\career-platform\\backend\\src\\app.ts","toolAction":"Writing backend/src/app.ts","toolSummary":"Create app.ts"}}]}
