{"step_index":109,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-10-13T12:50:14Z","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"import { z } from 'zod';\n\nexport const createBookingSchema = z.object({\n  consultantId: z.string().min(1, 'Consultant ID is required'),\n  startTime: z.string().datetime({ message: 'Start time must be a valid ISO datetime string' }),\n  userName: z.string().min(2, 'Name must be at least 2 characters'),\n  userEmail: z.string().email('Valid email is required'),\n  userPhone: z.string().optional(),\n  agenda: z.string().min(5, 'Please provide an agenda of at least 5 characters')\n});\n\nexport const queryBookingsSchema = z.object({\n  page: z.string().optional().transform(v => (v ? Math.max(1, parseInt(v, 10)) : 1)),\n  limit: z.string().optional().transform(v => (v ? Math.min(100, Math.max(1, parseInt(v, 10))) : 10)),\n  status: z.enum(['PENDING_PAYMENT', 'PAYMENT_FAILED', 'PAID', 'CONFIRMED', 'CANCELLED', 'COMPLETED']).optional(),\n  search: z.string().optional(),\n  sort: z.string().optional().default('-createdAt')\n});\n","Description":"Create booking request validation schemas","Overwrite":true,"TargetFile":"C:\\Users\\PRIYANKA\\.gemini\\antigravity\\scratch\\career-platform\\backend\\src\\modules\\bookings\\booking.validation.ts","toolAction":"Writing backend/src/modules/bookings/booking.validation.ts","toolSummary":"Create booking.validation.ts"}}]}
{"step_index":110,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-13T12:50:20Z","content":"Created At: 2026-10-13T18:20:20+05:30\nCompleted At: 2026-10-13T18:20:20+05:30\nCreated file file:///C:/Users/PRIYANKA/.gemini/antigravity/scratch/career-platform/backend/src/modules/bookings/booking.validation.ts with requested content.\nIf relevant, proactively run terminal commands to execute this code for the USER. Don't ask for permission."}
{"step_index":111,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-10-13T12:50:20Z","thinking":"Developing the Booking Controller requires implementing several critical business rules. Firstly, past booking times must be rejected to prevent scheduling errors. Secondly, consultant validation is essential to ensure existence and active status. Booking duration calculations must also accurately determine the `endTime`. Finally, the controller will need to check and prevent overlapping bookings based on specific statuses.\n\n\n","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"import { Request, Response, NextFunction } from 'express';\nimport { Types } from 'mongoose';\nimport { Booking, BookingStatus } from './booking.model';\nimport { Consultant } from '../consultants/consultant.model';\nimport { BadRequestError, NotFoundError, UnauthorizedError, ForbiddenError, ConflictError } from '../../utils/errors';\n\nexport const createBooking = async (req: Request, res: Response, next: NextFunction): Promise<void> => {\n  try {\n    if (!req.user) throw new UnauthorizedError();\n    const { consultantId, startTime, userName, userEmail, userPhone, agenda } = req.body;\n\n    const startDate = new Date(startTime);\n    const now = new Date();\n\n    // 1. Reject bookings in the past\n    if (startDate.getTime() <= now.getTime()) {\n      throw new BadRequestError('Cannot book consultation appointments in the past');\n    }\n\n    // 2. Validate consultant exists and is active\n    const consultant = await Consultant.findById(consultantId);\n    if (!consultant || !consultant.isActive) {\n      throw new NotFoundError('Selected consultant is not available for bookings');\n    }\n\n    const duration = consultant.durationMinutes || 45;\n    const endDate = new Date(startDate.getTime() + duration * 60 * 1000);\n\n    // 3. Concurrency / Overlap check\n    // Check if consultant has an active overlapping booking\n    const overlapping = await Booking.findOne({\n      consultantId: consultant._id,\n      status: { $in: ['PENDING_PAYMENT', 'PAID', 'CONFIRMED'] },\n      $or: [\n        {\n          startTime: { $lt: endDate },\n          endTime: { $gt: startDate }\n        }\n      ]\n    });\n\n    if (overlapping) {\n      throw new ConflictError('This time slot has already been reserved. Please choose another time.');\n    }\n\n    // 4. Create booking with server-calculated price\n    const booking = new Booking({\n      userId: new Types.ObjectId(req.user.userId),\n      consultantId: consultant._id,\n      userName,\n      userEmail,\n      userPhone: userPhone || '',\n      agenda,\n      startTime: startDate,\n      endTime: endDate,\n      durationMinutes: duration,\n      amount: consultant.hourlyRate, // Strict server-side pricing\n      currency: 'usd',\n      status: 'PENDING_PAYMENT',\n      calendarStatus: 'NOT_SCHEDULED',\n      emailStatus: 'NOT_SENT'\n    });\n\n    await booking.save();\n\n    res.status(201).json({\n      success: true,\n      message: 'Consultation slot reserved successfully. Please complete payment to confirm.',\n      data: { booking }\n    });\n  } catch (err) {\n    next(err);\n  }\n};\n\nexport const getBookings = async (req: Request, res: Response, next: NextFunction): Promise<void> => {\n  try {\n    if (!req.user) throw new UnauthorizedError();\n\n    const page = Math.max(1, parseInt(String(req.query.page || 1), 10));\n    const limit = Math.min(100, Math.max(1, parseInt(String(req.query.limit || 10), 10)));\n    const status = req.query.status as BookingStatus | undefined;\n    const search = req.query.search as string | undefined;\n    const sortField = String(req.query.sort || '-createdAt');\n\n    // Scoped filter to current user\n    const filter: Record<string, any> = { userId: new Types.ObjectId(req.user.userId) };\n\n    if (status) {\n      filter.status = status;\n    }\n\n    if (search) {\n      filter.$or = [\n        { userName: { $regex: search, $options: 'i' } },\n        { userEmail: { $regex: search, $options: 'i' } },\n        { agenda: { $regex: search, $options: 'i' } }\n      ];\n    }\n\n    // Allowed sort whitelist\n    const allowedSorts = ['createdAt', '-createdAt', 'startTime', '-startTime', 'amount', '-amount'];\n    const sort = allowedSorts.includes(sortField) ? sortField : '-createdAt';\n\n    const total = await Booking.countDocuments(filter);\n    const totalPages = Math.ceil(total / limit);\n    const skip = (page - 1) * limit;\n\n    const data = await Booking.find(filter)\n      .populate('consultantId', 'name title email avatarUrl')\n      .sort(sort)\n      .skip(skip)\n      .limit(limit);\n\n    res.status(200).json({\n      success: true,\n      data,\n      pagination: {\n        page,\n        limit,\n        total,\n        totalPages\n      }\n    });\n  } catch (err) {\n    next(err);\n  }\n};\n\nexport const getBookingById = async (req: Request, res: Response, next: NextFunction): Promise<void> => {\n  try {\n    if (!req.user) throw new UnauthorizedError();\n    const { id } = req.params;\n\n    const booking = await Booking.findById(id).populate('consultantId', 'name title email avatarUrl hourlyRate');\n    if (!booking) {\n      throw new NotFoundError('Booking record not found');\n    }\n\n    if (booking.userId.toString() !== req.user.userId && req.user.role !== 'ADMIN') {\n      throw new ForbiddenError('You do not have access to view this booking');\n    }\n\n    res.status(200).json({\n      success: true,\n      data: { booking }\n    });\n  } catch (err) {\n    next(err);\n  }\n};\n\nexport const cancelBooking = async (req: Request, res: Response, next: NextFunction): Promise<void> => {\n  try {\n    if (!req.user) throw new UnauthorizedError();\n    const { id } = req.params;\n\n    const booking = await Booking.findById(id);\n    if (!booking) {\n      throw new NotFoundError('Booking record not found');\n    }\n\n    if (booking.userId.toString() !== req.user.userId && req.user.role !== 'ADMIN') {\n      throw new ForbiddenError('You do not have access to cancel this booking');\n    }\n\n    // State machine check\n    const nonCancellableStates: BookingStatus[] = ['CANCELLED', 'COMPLETED', 'PAYMENT_FAILED'];\n    if (nonCancellableStates.includes(booking.status)) {\n      throw new BadRequestError(`Cannot cancel a booking in status \"${booking.status}\"`);\n    }\n\n    booking.status = 'CANCELLED';\n    await booking.save();\n\n    res.status(200).json({\n      success: true,\n      message: 'Booking cancelled successfully',\n      data: { booking }\n    });\n  } catch (err) {\n    next(err);\n  }\n};\n","Description":"Create booking controllers with concurrency protection, state machine checks, and server pagination","Overwrite":true,"TargetFile":"C:\\Users\\PRIYANKA\\.gemini\\antigravity\\scratch\\career-platform\\backend\\src\\modules\\bookings\\booking.controller.ts","toolAction":"Writing backend/src/modules/bookings/booking.controller.ts","toolSummary":"Create booking.controller.ts"}}]}
