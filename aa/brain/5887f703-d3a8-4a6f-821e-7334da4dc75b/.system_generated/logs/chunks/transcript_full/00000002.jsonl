{"step_index":157,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-10-13T12:55:37Z","thinking":"The focus shifts to creating comprehensive payment tests. Specifically, tests will cover checkout session creation with server-side price calculation and webhook validation. Also, verifying the successful payment transitions to a `SUCCEEDED` status, while the associated booking correctly moves to `CONFIRMED`. Finally, the tests will confirm generation of a meeting link and dispatch of confirmation, along with a critical idempotency test for webhooks.\n\n\n","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"import request from 'supertest';\nimport app from '../src/app';\nimport { Consultant } from '../src/modules/consultants/consultant.model';\nimport { Booking } from '../src/modules/bookings/booking.model';\nimport { Payment } from '../src/modules/payments/payment.model';\nimport './setup';\n\ndescribe('Stripe Payments & Webhook Idempotency API', () => {\n  let userToken: string;\n  let bookingId: string;\n\n  beforeEach(async () => {\n    const regRes = await request(app).post('/api/auth/register').send({\n      name: 'Payment Tester',\n      email: 'payer@example.com',\n      password: 'Password123!'\n    });\n    userToken = regRes.body.data.token;\n\n    const consultant = await Consultant.create({\n      name: 'Marcus Brody',\n      title: 'Principal Career Consultant',\n      bio: 'Executive coach.',\n      email: 'marcus@consultants.com',\n      hourlyRate: 15000,\n      durationMinutes: 45,\n      isActive: true,\n      availability: [{ dayOfWeek: 2, startTime: '09:00', endTime: '18:00' }]\n    });\n\n    const futureDate = new Date(Date.now() + 5 * 24 * 60 * 60 * 1000);\n    futureDate.setUTCHours(11, 0, 0, 0);\n\n    const booking = await Booking.create({\n      userId: regRes.body.data.user.id,\n      consultantId: consultant._id,\n      userName: 'Payment Tester',\n      userEmail: 'payer@example.com',\n      agenda: 'Salary negotiation and portfolio review',\n      startTime: futureDate,\n      endTime: new Date(futureDate.getTime() + 45 * 60 * 1000),\n      durationMinutes: 45,\n      amount: 15000,\n      status: 'PENDING_PAYMENT'\n    });\n    bookingId = booking._id.toString();\n  });\n\n  it('should create a checkout session for a pending booking', async () => {\n    const res = await request(app)\n      .post('/api/payments/checkout')\n      .set('Authorization', `Bearer ${userToken}`)\n      .send({ bookingId });\n\n    expect(res.status).toBe(200);\n    expect(res.body.success).toBe(true);\n    expect(res.body.data.checkoutUrl).toBeDefined();\n    expect(res.body.data.sessionId).toBeDefined();\n\n    const payment = await Payment.findOne({ bookingId });\n    expect(payment).toBeDefined();\n    expect(payment?.amount).toBe(15000); // Verified server-side price\n    expect(payment?.status).toBe('PENDING');\n  });\n\n  it('should process webhook idempotently and transition booking to CONFIRMED', async () => {\n    // 1. Initialize checkout\n    const checkoutRes = await request(app)\n      .post('/api/payments/checkout')\n      .set('Authorization', `Bearer ${userToken}`)\n      .send({ bookingId });\n\n    const sessionId = checkoutRes.body.data.sessionId;\n    const eventId = `evt_test_${Date.now()}`;\n\n    // 2. Deliver webhook event\n    const webhookPayload = {\n      id: eventId,\n      type: 'checkout.session.completed',\n      data: {\n        object: {\n          id: sessionId,\n          client_reference_id: bookingId,\n          payment_intent: 'pi_test_123456789',\n          metadata: { bookingId }\n        }\n      }\n    };\n\n    const webhookRes = await request(app)\n      .post('/api/payments/webhook')\n      .send(webhookPayload);\n\n    expect(webhookRes.status).toBe(200);\n    expect(webhookRes.body.received).toBe(true);\n\n    // Verify booking updated to CONFIRMED and has meeting link\n    const updatedBooking = await Booking.findById(bookingId);\n    expect(updatedBooking?.status).toBe('CONFIRMED');\n    expect(updatedBooking?.meetingUrl).toBeDefined();\n    expect(updatedBooking?.calendarStatus).toBe('SCHEDULED');\n\n    const updatedPayment = await Payment.findOne({ bookingId });\n    expect(updatedPayment?.status).toBe('SUCCEEDED');\n    expect(updatedPayment?.processedWebhookEvents).toContain(eventId);\n\n    // 3. Duplicate webhook test: send the same event again\n    const duplicateRes = await request(app)\n      .post('/api/payments/webhook')\n      .send(webhookPayload);\n\n    expect(duplicateRes.status).toBe(200);\n    expect(duplicateRes.body.duplicate).toBe(true);\n\n    // Ensure status remains confirmed and not corrupted\n    const recheckedBooking = await Booking.findById(bookingId);\n    expect(recheckedBooking?.status).toBe('CONFIRMED');\n  });\n});\n","Description":"Create payments, webhook verification, and idempotency test suite","Overwrite":true,"TargetFile":"C:\\Users\\PRIYANKA\\.gemini\\antigravity\\scratch\\career-platform\\backend\\tests\\payments.test.ts","toolAction":"Writing backend/tests/payments.test.ts","toolSummary":"Create payments.test.ts"}}]}
