{"step_index":117,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-10-13T12:50:56Z","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"import nodemailer from 'nodemailer';\nimport { env } from '../config/env';\nimport { logger } from '../utils/logger';\n\nexport interface BookingConfirmationEmailParams {\n  to: string;\n  userName: string;\n  consultantName: string;\n  dateStr: string;\n  timeStr: string;\n  meetingUrl?: string;\n  bookingId: string;\n  agenda: string;\n}\n\nexport interface IEmailAdapter {\n  sendBookingConfirmation(params: BookingConfirmationEmailParams): Promise<boolean>;\n}\n\nclass MockEmailAdapter implements IEmailAdapter {\n  async sendBookingConfirmation(params: BookingConfirmationEmailParams): Promise<boolean> {\n    logger.info(`[MockEmailAdapter (Development Fallback)] Booking confirmation email dispatched to ${params.to} for Booking ID: ${params.bookingId}`);\n    logger.info(`[MockEmailAdapter] Meeting details: Consultant: ${params.consultantName}, Date: ${params.dateStr} at ${params.timeStr}, Link: ${params.meetingUrl || 'Pending'}`);\n    return true;\n  }\n}\n\nclass NodemailerAdapter implements IEmailAdapter {\n  private transporter: nodemailer.Transporter | null = null;\n\n  constructor() {\n    if (env.EMAIL_USER && env.EMAIL_PASSWORD) {\n      this.transporter = nodemailer.createTransport({\n        host: env.EMAIL_HOST,\n        port: env.EMAIL_PORT,\n        secure: env.EMAIL_PORT === 465,\n        auth: {\n          user: env.EMAIL_USER,\n          pass: env.EMAIL_PASSWORD\n        }\n      });\n    }\n  }\n\n  async sendBookingConfirmation(params: BookingConfirmationEmailParams): Promise<boolean> {\n    if (!this.transporter) {\n      logger.warn('[NodemailerAdapter] SMTP credentials not configured. Falling back to MockEmailAdapter.');\n      return new MockEmailAdapter().sendBookingConfirmation(params);\n    }\n\n    try {\n      const html = `\n        <div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; padding: 20px; border: 1px solid #e2e8f0; border-radius: 8px;\">\n          <h2 style=\"color: #2563eb; margin-top: 0;\">Consultation Booking Confirmed!</h2>\n          <p>Dear <strong>${params.userName}</strong>,</p>\n          <p>Your career consultation with <strong>${params.consultantName}</strong> has been successfully booked and confirmed.</p>\n          \n          <div style=\"background-color: #f8fafc; padding: 16px; border-radius: 6px; margin: 20px 0;\">\n            <p style=\"margin: 4px 0;\"><strong>Date:</strong> ${params.dateStr}</p>\n            <p style=\"margin: 4px 0;\"><strong>Time:</strong> ${params.timeStr} (UTC)</p>\n            <p style=\"margin: 4px 0;\"><strong>Booking Reference:</strong> <code>${params.bookingId}</code></p>\n            <p style=\"margin: 4px 0;\"><strong>Agenda:</strong> ${params.agenda}</p>\n            ${params.meetingUrl ? `<p style=\"margin: 12px 0 4px 0;\"><strong>Meeting Link:</strong> <a href=\"${params.meetingUrl}\" style=\"color: #2563eb; font-weight: bold;\">Join Video Consultation</a></p>` : ''}\n          </div>\n\n          <p style=\"color: #64748b; font-size: 13px;\">If you have any questions or need to reschedule, please reach out through your dashboard.</p>\n        </div>\n      `;\n\n      await this.transporter.sendMail({\n        from: env.EMAIL_FROM,\n        to: params.to,\n        subject: `Confirmed: Consultation with ${params.consultantName}`,\n        html\n      });\n\n      logger.info(`[NodemailerAdapter] Confirmation email successfully delivered to ${params.to}`);\n      return true;\n    } catch (err) {\n      logger.error('[NodemailerAdapter] Error sending confirmation email:', err);\n      throw err;\n    }\n  }\n}\n\nexport const getEmailAdapter = (): IEmailAdapter => {\n  if (env.EMAIL_USER && env.EMAIL_PASSWORD) {\n    return new NodemailerAdapter();\n  }\n  return new MockEmailAdapter();\n};\n","Description":"Create email notification adapter with SMTP and mock fallback","Overwrite":true,"TargetFile":"C:\\Users\\PRIYANKA\\.gemini\\antigravity\\scratch\\career-platform\\backend\\src\\integrations\\email.ts","toolAction":"Writing backend/src/integrations/email.ts","toolSummary":"Create email.ts"}}]}
