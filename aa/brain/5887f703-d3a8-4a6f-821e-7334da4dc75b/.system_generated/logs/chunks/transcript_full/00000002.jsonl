oid> => {\n  try {\n    const demoConsultants = [\n      {\n        name: 'Sarah Jenkins',\n        title: 'Principal Technical Recruiter & Career Strategist',\n        bio: 'Former Staff Recruiter at Google and Meta. Over 12 years evaluating software engineering candidates and executive leaders.',\n        expertise: ['Software Engineering', 'Big Tech Interviews', 'Offer Negotiation', 'Resume Strategy'],\n        email: 'sarah.jenkins@consultants.careerplatform.com',\n        hourlyRate: 15000, // $150.00\n        durationMinutes: 45,\n        isActive: true,\n        avatarUrl: 'https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?w=150&auto=format&fit=crop&q=80',\n        availability: [\n          { dayOfWeek: 1, startTime: '09:00', endTime: '18:00' },\n          { dayOfWeek: 2, startTime: '09:00', endTime: '18:00' },\n          { dayOfWeek: 3, startTime: '09:00', endTime: '18:00' },\n          { dayOfWeek: 4, startTime: '09:00', endTime: '18:00' },\n          { dayOfWeek: 5, startTime: '09:00', endTime: '17:00' }\n        ]\n      },\n      {\n        name: 'David Chen',\n        title: 'VP of Engineering & Executive Career Coach',\n        bio: '20+ years building high-velocity engineering organizations. Specializes in senior engineering management and executive leadership transitions.',\n        expertise: ['Engineering Management', 'System Design', 'Leadership Transitions', 'Executive Coaching'],\n        email: 'david.chen@consultants.careerplatform.com',\n        hourlyRate: 20000, // $200.00\n        durationMinutes: 45,\n        isActive: true,\n        avatarUrl: 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=150&auto=format&fit=crop&q=80',\n        availability: [\n          { dayOfWeek: 1, startTime: '10:00', endTime: '17:00' },\n          { dayOfWeek: 3, startTime: '10:00', endTime: '17:00' },\n          { dayOfWeek: 5, startTime: '10:00', endTime: '17:00' }\n        ]\n      },\n      {\n        name: 'Maya Patel',\n        title: 'Lead Product Design Career Consultant',\n        bio: 'Design Director with a passion for helping UX/UI designers and Product Managers craft compelling portfolios and master case study presentations.',\n        expertise: ['UX/UI Design', 'Product Management', 'Portfolio Reviews', 'Case Study Prep'],\n        email: 'maya.patel@consultants.careerplatform.com',\n        hourlyRate: 13000, // $130.00\n        durationMinutes: 45,\n        isActive: true,\n        avatarUrl: 'https://images.unsplash.com/photo-1580489944761-15a19d654956?w=150&auto=format&fit=crop&q=80',\n        availability: [\n          { dayOfWeek: 2, startTime: '09:00', endTime: '17:00' },\n          { dayOfWeek: 4, startTime: '09:00', endTime: '17:00' },\n          { dayOfWeek: 6, startTime: '10:00', endTime: '14:00' }\n        ]\n      }\n    ];\n\n    for (const consultantData of demoConsultants) {\n      await Consultant.findOneAndUpdate(\n        { email: consultantData.email },\n        consultantData,\n        { upsert: true, new: true }\n      );\n    }\n\n    const allConsultants = await Consultant.find();\n\n    res.status(200).json({\n      success: true,\n      message: 'Demonstration consultants seeded successfully',\n      data: { consultants: allConsultants }\n    });\n  } catch (err) {\n    next(err);\n  }\n};\n","Description":"Create consultant listing, availability calculation, and seeding controllers","Overwrite":true,"TargetFile":"C:\\Users\\PRIYANKA\\.gemini\\antigravity\\scratch\\career-platform\\backend\\src\\modules\\consultants\\consultant.controller.ts","toolAction":"Writing backend/src/modules/consultants/consultant.controller.ts","toolSummary":"Create consultant.controller.ts"}}]}
