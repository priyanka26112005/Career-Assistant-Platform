{"step_index":93,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-10-13T12:48:28Z","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"import { z } from 'zod';\n\nconst personalInfoSchema = z.object({\n  fullName: z.string().default(''),\n  email: z.string().default(''),\n  phone: z.string().optional().default(''),\n  location: z.string().optional().default(''),\n  linkedin: z.string().optional().default(''),\n  website: z.string().optional().default('')\n});\n\nconst experienceSchema = z.object({\n  id: z.string().optional(),\n  company: z.string().min(1, 'Company is required'),\n  role: z.string().min(1, 'Role is required'),\n  location: z.string().optional(),\n  startDate: z.string().optional(),\n  endDate: z.string().optional(),\n  current: z.boolean().optional(),\n  description: z.string().optional(),\n  highlights: z.array(z.string()).default([])\n});\n\nconst educationSchema = z.object({\n  id: z.string().optional(),\n  institution: z.string().min(1, 'Institution is required'),\n  degree: z.string().min(1, 'Degree is required'),\n  fieldOfStudy: z.string().optional(),\n  startDate: z.string().optional(),\n  endDate: z.string().optional(),\n  gpa: z.string().optional()\n});\n\nconst projectSchema = z.object({\n  id: z.string().optional(),\n  title: z.string().min(1, 'Title is required'),\n  description: z.string().default(''),\n  technologies: z.array(z.string()).default([]),\n  link: z.string().optional()\n});\n\nconst certificationSchema = z.object({\n  id: z.string().optional(),\n  name: z.string().min(1, 'Name is required'),\n  issuer: z.string().optional(),\n  issueDate: z.string().optional()\n});\n\nexport const createResumeSchema = z.object({\n  title: z.string().min(1).max(100).default('Untitled Resume'),\n  template: z.enum(['MODERN_PROFESSIONAL', 'ATS_CLASSIC']).default('MODERN_PROFESSIONAL')\n});\n\nexport const updateResumeSchema = z.object({\n  title: z.string().min(1).max(100).optional(),\n  template: z.enum(['MODERN_PROFESSIONAL', 'ATS_CLASSIC']).optional(),\n  personalInfo: personalInfoSchema.optional(),\n  summary: z.string().optional(),\n  experience: z.array(experienceSchema).optional(),\n  education: z.array(educationSchema).optional(),\n  skills: z.array(z.string()).optional(),\n  projects: z.array(projectSchema).optional(),\n  certifications: z.array(certificationSchema).optional(),\n  achievements: z.array(z.string()).optional()\n});\n\nexport const generateSectionSchema = z.object({\n  section: z.enum(['summary', 'experience', 'skills', 'achievements']),\n  prompt: z.string().min(1, 'Prompt cannot be empty')\n});\n","Description":"Create resume validation schemas","Overwrite":true,"TargetFile":"C:\\Users\\PRIYANKA\\.gemini\\antigravity\\scratch\\career-platform\\backend\\src\\modules\\resumes\\resume.validation.ts","toolAction":"Writing backend/src/modules/resumes/resume.validation.ts","toolSummary":"Create resume.validation.ts"}}]}
