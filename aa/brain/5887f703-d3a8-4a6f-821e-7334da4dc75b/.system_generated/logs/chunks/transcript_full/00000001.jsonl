{"step_index":97,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-10-13T12:49:01Z","thinking":"Planning the `resume.controller.ts` file involves defining endpoints for resume management. The endpoints will handle operations such as creating, retrieving, updating, and deleting resumes. Additional functionality includes AI-driven content generation for resume sections and the export of resumes into HTML based on a chosen template.\n\n\n","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"import { Request, Response, NextFunction } from 'express';\nimport { Types } from 'mongoose';\nimport { Resume, IResume } from './resume.model';\nimport { getLLMProvider } from '../../integrations/llm';\nimport { renderModernProfessional, renderATSClassic } from './resume.templates';\nimport { NotFoundError, UnauthorizedError, ForbiddenError } from '../../utils/errors';\n\nexport const createResume = async (req: Request, res: Response, next: NextFunction): Promise<void> => {\n  try {\n    if (!req.user) throw new UnauthorizedError();\n    const { title, template } = req.body;\n\n    const resume = new Resume({\n      userId: new Types.ObjectId(req.user.userId),\n      title: title || 'Untitled Resume',\n      template: template || 'MODERN_PROFESSIONAL'\n    });\n    await resume.save();\n\n    res.status(201).json({\n      success: true,\n      data: { resume }\n    });\n  } catch (err) {\n    next(err);\n  }\n};\n\nexport const getResumes = async (req: Request, res: Response, next: NextFunction): Promise<void> => {\n  try {\n    if (!req.user) throw new UnauthorizedError();\n\n    const resumes = await Resume.find({ userId: req.user.userId })\n      .sort({ updatedAt: -1 });\n\n    res.status(200).json({\n      success: true,\n      data: { resumes }\n    });\n  } catch (err) {\n    next(err);\n  }\n};\n\nexport const getResume = async (req: Request, res: Response, next: NextFunction): Promise<void> => {\n  try {\n    if (!req.user) throw new UnauthorizedError();\n    const { id } = req.params;\n\n    const resume = await Resume.findById(id);\n    if (!resume) {\n      throw new NotFoundError('Resume not found');\n    }\n\n    if (resume.userId.toString() !== req.user.userId) {\n      throw new ForbiddenError('You do not have permission to view this resume');\n    }\n\n    res.status(200).json({\n      success: true,\n      data: { resume }\n    });\n  } catch (err) {\n    next(err);\n  }\n};\n\nexport const updateResume = async (req: Request, res: Response, next: NextFunction): Promise<void> => {\n  try {\n    if (!req.user) throw new UnauthorizedError();\n    const { id } = req.params;\n\n    const resume = await Resume.findById(id);\n    if (!resume) {\n      throw new NotFoundError('Resume not found');\n    }\n\n    if (resume.userId.toString() !== req.user.userId) {\n      throw new ForbiddenError('You do not have permission to modify this resume');\n    }\n\n    const {\n      title,\n      template,\n      personalInfo,\n      summary,\n      experience,\n      education,\n      skills,\n      projects,\n      certifications,\n      achievements\n    } = req.body;\n\n    if (title !== undefined) resume.title = title;\n    if (template !== undefined) resume.template = template;\n    if (personalInfo !== undefined) resume.personalInfo = personalInfo;\n    if (summary !== undefined) resume.summary = summary;\n    if (experience !== undefined) resume.experience = experience;\n    if (education !== undefined) resume.education = education;\n    if (skills !== undefined) resume.skills = skills;\n    if (projects !== undefined) resume.projects = projects;\n    if (certifications !== undefined) resume.certifications = certifications;\n    if (achievements !== undefined) resume.achievements = achievements;\n\n    await resume.save();\n\n    res.status(200).json({\n      success: true,\n      message: 'Resume updated successfully',\n      data: { resume }\n    });\n  } catch (err) {\n    next(err);\n  }\n};\n\nexport const deleteResume = async (req: Request, res: Response, next: NextFunction): Promise<void> => {\n  try {\n    if (!req.user) throw new UnauthorizedError();\n    const { id } = req.params;\n\n    const resume = await Resume.findById(id);\n    if (!resume) {\n      throw new NotFoundError('Resume not found');\n    }\n\n    if (resume.userId.toString() !== req.user.userId) {\n      throw new ForbiddenError('You do not have permission to delete this resume');\n    }\n\n    await Resume.findByIdAndDelete(id);\n\n    res.status(200).json({\n      success: true,\n      message: 'Resume deleted successfully'\n    });\n  } catch (err) {\n    next(err);\n  }\n};\n\nexport const generateSection = async (req: Request, res: Response, next: NextFunction): Promise<void> => {\n  try {\n    if (!req.user) throw new UnauthorizedError();\n    const { id } = req.params;\n    const { section, prompt } = req.body;\n\n    const resume = await Resume.findById(id);\n    if (!resume) {\n      throw new NotFoundError('Resume not found');\n    }\n\n    if (resume.userId.toString() !== req.user.userId) {\n      throw new ForbiddenError('You do not have permission to modify this resume');\n    }\n\n    const llmProvider = getLLMProvider();\n    const currentData = (resume as any)[section];\n    const generatedContent = await llmProvider.generateStructuredResumeSection(section, prompt, currentData);\n\n    (resume as any)[section] = generatedContent;\n    await resume.save();\n\n    res.status(200).json({\n      success: true,\n      message: `Section ${section} generated successfully`,\n      data: {\n        section,\n        content: generatedContent,\n        resume\n      }\n    });\n  } catch (err) {\n    next(err);\n  }\n};\n\nexport const exportResume = async (req: Request, res: Response, next: NextFunction): Promise<void> => {\n  try {\n    if (!req.user) throw new UnauthorizedError();\n    const { id } = req.params;\n    const templateOverride = req.query.template as string | undefined;\n\n    const resume = await Resume.findById(id);\n    if (!resume) {\n      throw new NotFoundError('Resume not found');\n    }\n\n    if (resume.userId.toString() !== req.user.userId) {\n      throw new ForbiddenError('You do not have permission to export this resume');\n    }\n\n    const selectedTemplate = templateOverride || resume.template || 'MODERN_PROFESSIONAL';\n    const html = selectedTemplate === 'ATS_CLASSIC'\n      ? renderATSClassic(resume)\n      : renderModernProfessional(resume);\n\n    if (req.query.format === 'raw') {\n      res.setHeader('Content-Type', 'text/html');\n      res.send(html);\n      return;\n    }\n\n    res.status(200).json({\n      success: true,\n      data: {\n        template: selectedTemplate,\n        html\n      }\n    });\n  } catch (err) {\n    next(err);\n  }\n};\n","Description":"Create resume CRUD, AI generation, and export controllers","Overwrite":true,"TargetFile":"C:\\Users\\PRIYANKA\\.gemini\\antigravity\\scratch\\career-platform\\backend\\src\\modules\\resumes\\resume.controller.ts","toolAction":"Writing backend/src/modules/resumes/resume.controller.ts","toolSummary":"Create resume.controller.ts"}}]}
