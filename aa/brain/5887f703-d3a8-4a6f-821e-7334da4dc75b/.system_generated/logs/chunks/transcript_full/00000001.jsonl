().transform((val) => parseInt(val, 10)).default('5000'),\n  FRONTEND_URL: z.string().default('http://localhost:3000'),\n  BACKEND_URL: z.string().default('http://localhost:5000'),\n  MONGODB_URI: z.string().default('mongodb://127.0.0.1:27017/career_platform'),\n  JWT_SECRET: z.string().default('career-platform-super-secret-jwt-key-min-32-chars-long'),\n  JWT_EXPIRES_IN: z.string().default('7d'),\n  COOKIE_SECRET: z.string().default('career-platform-cookie-secret-key-32-chars'),\n  \n  // AI\n  LLM_PROVIDER: z.enum(['mock', 'openai', 'gemini']).default('mock'),\n  LLM_API_KEY: z.string().optional().default(''),\n  LLM_MODEL: z.string().optional().default('gpt-4o-mini'),\n\n  // Stripe\n  STRIPE_SECRET_KEY: z.string().optional().default('sk_test_placeholder'),\n  STRIPE_WEBHOOK_SECRET: z.string().optional().default('whsec_placeholder'),\n  NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY: z.string().optional().default('pk_test_placeholder'),\n\n  // Google Calendar\n  GOOGLE_CLIENT_ID: z.string().optional().default(''),\n  GOOGLE_CLIENT_SECRET: z.string().optional().default(''),\n  GOOGLE_REDIRECT_URI: z.string().optional().default('http://localhost:5000/api/calendar/callback'),\n  GOOGLE_REFRESH_TOKEN: z.string().optional().default(''),\n\n  // Email\n  EMAIL_HOST: z.string().optional().default('smtp.mailtrap.io'),\n  EMAIL_PORT: z.string().transform((val) => parseInt(val, 10)).default('587'),\n  EMAIL_USER: z.string().optional().default(''),\n  EMAIL_PASSWORD: z.string().optional().default(''),\n  EMAIL_FROM: z.string().default('no-reply@careerplatform.com')\n});\n\nconst parsedEnv = envSchema.safeParse(process.env);\n\nif (!parsedEnv.success) {\n  console.error('❌ Invalid environment configuration:', parsedEnv.error.format());\n  throw new Error('Invalid environment configuration');\n}\n\nexport const env = parsedEnv.data;\n","Description":"Create backend environment validation with Zod","Overwrite":true,"TargetFile":"C:\\Users\\PRIYANKA\\.gemini\\antigravity\\scratch\\career-platform\\backend\\src\\config\\env.ts","toolAction":"Writing backend/src/config/env.ts","toolSummary":"Create env.ts"}}]}
