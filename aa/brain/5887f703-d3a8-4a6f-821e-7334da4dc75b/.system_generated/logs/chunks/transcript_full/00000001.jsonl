{"step_index":81,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-10-13T12:47:07Z","thinking":"Define MongoDB models for chat sessions and messages, including necessary fields and indexes for efficient querying. A pluggable AI integration layer will be designed using an `LLMProvider` interface to handle chat response generation.\n\n\n","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"import { env } from '../config/env';\nimport { logger } from '../utils/logger';\n\nexport interface ChatMessagePayload {\n  role: 'user' | 'assistant' | 'system';\n  content: string;\n}\n\nexport interface ILLMProvider {\n  name: string;\n  generateResponse(messages: ChatMessagePayload[]): Promise<string>;\n  generateStructuredResumeSection(sectionType: string, userInput: string, currentData?: unknown): Promise<any>;\n}\n\nclass MockLLMProvider implements ILLMProvider {\n  name = 'Mock LLM Provider (Development Fallback)';\n\n  async generateResponse(messages: ChatMessagePayload[]): Promise<string> {\n    const lastUserMsg = [...messages].reverse().find(m => m.role === 'user')?.content.toLowerCase() || '';\n    logger.info(`[MockLLMProvider] Simulating career advice response for message: \"${lastUserMsg.slice(0, 50)}...\"`);\n\n    if (lastUserMsg.includes('interview')) {\n      return `Here are 4 targeted strategies for your upcoming interview:\\n\\n1. **STAR Technique**: Structure your stories with Situation, Task, Action, and Result.\\n2. **Company Alignment**: Review their engineering principles and recent product launches.\\n3. **System Design Practice**: Clearly articulate trade-offs between latency, consistency, and cost.\\n4. **Questions for the Interviewer**: Ask about deployment cadence, team mentorship, and career progression frameworks.`;\n    }\n\n    if (lastUserMsg.includes('resume') || lastUserMsg.includes('cv')) {\n      return `To make your resume stand out to hiring managers and ATS filters:\\n\\n- **Lead with Impact**: Use the formula \"Accomplished [X], measured by [Y], by doing [Z]\".\\n- **Keyword Optimization**: Mirror the exact tools and methodologies from your target job descriptions.\\n- **Clarity over Flash**: Use a structured single- or clean dual-column layout without unparsable graphics.\\n- **Quantify Results**: Highlight metrics like \"% latency reduction\", \"$ revenue uplift\", or \"hours saved per sprint\".`;\n    }\n\n    if (lastUserMsg.includes('salary') || lastUserMsg.includes('offer')) {\n      return `When approaching salary negotiations:\\n\\n1. Always benchmark market compensation across Levels.fyi, Glassdoor, and peer networks.\\n2. Express enthusiasm for the team before discussing compensation adjustments.\\n3. Frame your request around the quantifiable value you will deliver.\\n4. Consider the total package, including equity vesting schedules, sign-on bonuses, and flexible work allowances.`;\n    }\n\n    return `Thank you for sharing your career goals! As your AI Career Coach, I can help you with:\\n\\n1. **Resume Refinement**: Polishing bullet points and optimizing for ATS.\\n2. **Interview Preparation**: Behavioral questions, technical frameworks, and mock scenarios.\\n3. **Career Trajectory & Transition**: Identifying high-leverage skills to bridge into your next role.\\n4. **Negotiation Strategies**: Maximizing total compensation with confidence.\\n\\nWhat specific challenge would you like to tackle today?`;\n  }\n\n  async generateStructuredResumeSection(sectionType: string, userInput: string, currentData?: unknown): Promise<any> {\n    logger.info(`[MockLLMProvider] Generating structured resume section for [${sectionType}]`);\n\n    switch (sectionType) {\n      case 'summary':\n        return `Results-driven software engineering professional with proven expertise in building scalable cloud architectures and high-impact web applications. Adept at cross-functional leadership, modern full-stack frameworks, and delivering high-availability customer-facing products that drive measurable business outcomes.`;\n\n      case 'experience':\n        return [\n          {\n            id: 'mock-exp-1',\n            company: 'Tech Innovators Inc.',\n            role: 'Senior Full Stack Engineer',\n            location: 'San Francisco, CA (Remote)',\n            startDate: '2022-01',\n            endDate: 'Present',\n            current: true,\n            description: 'Led end-to-end development of enterprise cloud services and micro-frontend architectures.',\n            highlights: [\n              'Architected distributed microservices handling over 5M daily requests with 99.99% availability.',\n              'Spearheaded automated CI/CD pipeline modernization, reducing release lead time by 42%.',\n              'Mentored 6 junior and mid-level engineers in test-driven development and clean code practices.'\n            ]\n          }\n        ];\n\n      case 'skills':\n        return [\n          'TypeScript', 'JavaScript', 'Node.js', 'React', 'Next.js', 'Express.js',\n          'MongoDB', 'PostgreSQL', 'Docker', 'AWS', 'GraphQL', 'RESTful APIs',\n          'Tailwind CSS', 'CI/CD Pipelines', 'System Design'\n        ];\n\n      case 'achievements':\n        return [\n          'Reduced API latency by 35% through Redis caching and query indexing.',\n          'Awarded Engineering Excellence Award (Q3 2024) for zero-downtime database migration.',\n          'Authored comprehensive team design system used across 8 distinct internal platforms.'\n        ];\n\n      default:\n        return userInput;\n    }\n  }\n}\n\nclass OpenAIProvider implements ILLMProvider {\n  name = 'OpenAI Provider';\n  private apiKey: string;\n  private model: string;\n\n  constructor(apiKey: string, model: string) {\n    this.apiKey = apiKey;\n    this.model = model;\n  }\n\n  async generateResponse(messages: ChatMessagePayload[]): Promise<string> {\n    if (!this.apiKey) {\n      logger.warn('OpenAI API key missing. Falling back to MockLLMProvider.');\n      return new MockLLMProvider().generateResponse(messages);\n    }\n\n    try {\n      const response = await fetch('https://api.openai.com/v1/chat/completions', {\n        method: 'POST',\n        headers: {\n          'Content-Type': 'application/json',\n          'Authorization': `Bearer ${this.apiKey}`\n        },\n        body: JSON.stringify({\n          model: this.model || 'gpt-4o-mini',\n          messages: [\n            {\n              role: 'system',\n              content: 'You are an elite, encouraging, and highly analytical AI Career Coach and Resume Consultant.'\n            },\n            ...messages\n          ],\n          temperature: 0.7,\n          max_tokens: 1000\n        })\n      });\n\n      if (!response.ok) {\n        const errorText = await response.text();\n        logger.error(`OpenAI API error response: ${errorText}`);\n        throw new Error(`OpenAI API returned status ${response.status}`);\n      }\n\n      const data = await response.json() as any;\n      return data.choices[0]?.message?.content || 'No response generated';\n    } catch (err) {\n      logger.error('Failed to generate response with OpenAI, falling back to mock provider:', err);\n      return new MockLLMProvider().generateResponse(messages);\n    }\n  }\n\n  async generateStructuredResumeSection(sectionType: string, userInput: string, currentData?: unknown): Promise<any> {\n    if (!this.apiKey) {\n      return new MockLLMProvider().generateStructuredResumeSection(sectionType, userInput, currentData);\n    }\n\n    const prompt = `You are an expert resume writer. Generate polished, professional resume content for the \"${sectionType}\" section.\nUser input or guidance: \"${userInput}\"\nExisting content: ${JSON.stringify(currentData || null)}\nReturn clean structured JSON matching the requested section content without markdown code blocks.`;\n\n    try {\n      const raw = await this.generateResponse([{ role: 'user', content: prompt }]);\n      const cleaned = raw.replace(/```json/g, '').replace(/```/g, '').trim();\n      return JSON.parse(cleaned);\n    } catch {\n      return new MockLLMProvider().generateStructuredResumeSection(sectionType, userInput, currentData);\n    }\n  }\n}\n\nexport const getLLMProvider = (): ILLMProvider => {\n  if (env.LLM_PROVIDER === 'openai' && env.LLM_API_KEY) {\n    return new OpenAIProvider(env.LLM_API_KEY, env.LLM_MODEL);\n  }\n  return new MockLLMProvider();\n};\n","Description":"Create LLM provider abstraction with OpenAI and Mock fallback providers","Overwrite":true,"TargetFile":"C:\\Users\\PRIYANKA\\.gemini\\antigravity\\scratch\\career-platform\\backend\\src\\integrations\\llm.ts","toolAction":"Writing backend/src/integrations/llm.ts","toolSummary":"Create llm.ts"}}]}
