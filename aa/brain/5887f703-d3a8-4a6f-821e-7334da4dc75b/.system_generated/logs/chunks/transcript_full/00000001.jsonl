{"step_index":103,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-10-13T12:49:38Z","thinking":"The consultant controller will implement endpoints for managing consultant data. It requires `getConsultants` for listing active consultants, supporting query parameters for filtering. There's a `getConsultantById` to retrieve a single consultant's information, and `getConsultantAvailability` will calculate available time slots, considering existing bookings. Finally, a `seedConsultants` endpoint will populate the database with initial demonstration data.\n\n\n","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"import { Request, Response, NextFunction } from 'express';\nimport { Consultant } from './consultant.model';\nimport { Booking } from '../bookings/booking.model';\nimport { NotFoundError, BadRequestError } from '../../utils/errors';\n\nexport const getConsultants = async (req: Request, res: Response, next: NextFunction): Promise<void> => {\n  try {\n    const { expertise, search } = req.query;\n    const filter: Record<string, any> = { isActive: true };\n\n    if (expertise) {\n      filter.expertise = { $in: [String(expertise)] };\n    }\n\n    if (search) {\n      filter.$or = [\n        { name: { $regex: String(search), $options: 'i' } },\n        { title: { $regex: String(search), $options: 'i' } },\n        { bio: { $regex: String(search), $options: 'i' } }\n      ];\n    }\n\n    const consultants = await Consultant.find(filter).sort({ name: 1 });\n\n    res.status(200).json({\n      success: true,\n      data: { consultants }\n    });\n  } catch (err) {\n    next(err);\n  }\n};\n\nexport const getConsultantById = async (req: Request, res: Response, next: NextFunction): Promise<void> => {\n  try {\n    const { id } = req.params;\n    const consultant = await Consultant.findById(id);\n    if (!consultant) {\n      throw new NotFoundError('Consultant not found');\n    }\n\n    res.status(200).json({\n      success: true,\n      data: { consultant }\n    });\n  } catch (err) {\n    next(err);\n  }\n};\n\nexport const getConsultantAvailability = async (req: Request, res: Response, next: NextFunction): Promise<void> => {\n  try {\n    const { id } = req.params;\n    const { date } = req.query; // Expects YYYY-MM-DD\n\n    if (!date || typeof date !== 'string') {\n      throw new BadRequestError('Query parameter \"date\" (YYYY-MM-DD) is required');\n    }\n\n    const consultant = await Consultant.findById(id);\n    if (!consultant) {\n      throw new NotFoundError('Consultant not found');\n    }\n\n    // Parse target date\n    const targetDate = new Date(`${date}T00:00:00.000Z`);\n    if (isNaN(targetDate.getTime())) {\n      throw new BadRequestError('Invalid date format. Use YYYY-MM-DD.');\n    }\n\n    const dayOfWeek = targetDate.getUTCDay();\n    const dayConfig = consultant.availability.find(a => a.dayOfWeek === dayOfWeek);\n\n    if (!dayConfig) {\n      res.status(200).json({\n        success: true,\n        data: {\n          date,\n          dayOfWeek,\n          slots: []\n        }\n      });\n      return;\n    }\n\n    // Fetch existing active bookings for this consultant on this day\n    const startOfDay = new Date(`${date}T00:00:00.000Z`);\n    const endOfDay = new Date(`${date}T23:59:59.999Z`);\n\n    const existingBookings = await Booking.find({\n      consultantId: consultant._id,\n      status: { $in: ['PENDING_PAYMENT', 'PAID', 'CONFIRMED'] },\n      startTime: { $gte: startOfDay, $lte: endOfDay }\n    });\n\n    const bookedStarts = new Set(\n      existingBookings.map(b => b.startTime.toISOString())\n    );\n\n    // Generate potential slots based on duration\n    const duration = consultant.durationMinutes || 45;\n    const [startHour, startMin] = dayConfig.startTime.split(':').map(Number);\n    const [endHour, endMin] = dayConfig.endTime.split(':').map(Number);\n\n    const startTotalMins = startHour * 60 + startMin;\n    const endTotalMins = endHour * 60 + endMin;\n\n    const slots: { startTime: string; endTime: string; isAvailable: boolean }[] = [];\n    const now = new Date();\n\n    for (let m = startTotalMins; m + duration <= endTotalMins; m += duration) {\n      const slotHour = Math.floor(m / 60);\n      const slotMin = m % 60;\n      const endM = m + duration;\n      const endSlotHour = Math.floor(endM / 60);\n      const endSlotMin = endM % 60;\n\n      const slotStartIso = new Date(\n        Date.UTC(\n          targetDate.getUTCFullYear(),\n          targetDate.getUTCMonth(),\n          targetDate.getUTCDate(),\n          slotHour,\n          slotMin,\n          0\n        )\n      ).toISOString();\n\n      const slotEndIso = new Date(\n        Date.UTC(\n          targetDate.getUTCFullYear(),\n          targetDate.getUTCMonth(),\n          targetDate.getUTCDate(),\n          endSlotHour,\n          endSlotMin,\n          0\n        )\n      ).toISOString();\n\n      const isPast = new Date(slotStartIso).getTime() <= now.getTime();\n      const isBooked = bookedStarts.has(slotStartIso);\n\n      slots.push({\n        startTime: slotStartIso,\n        endTime: slotEndIso,\n        isAvailable: !isPast && !isBooked\n      });\n    }\n\n    res.status(200).json({\n      success: true,\n      data: {\n        date,\n        dayOfWeek,\n        durationMinutes: duration,\n        slots\n      }\n    });\n  } catch (err) {\n    next(err);\n  }\n};\n\nexport const seedConsultants = async (req: Request, res: Response, next: NextFunction): Promise<v