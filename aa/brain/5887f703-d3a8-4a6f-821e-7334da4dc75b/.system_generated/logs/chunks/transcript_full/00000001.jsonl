{"step_index":87,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-10-13T12:47:45Z","thinking":"Planning the `chat.controller.ts` file involves defining several API endpoints.  Endpoints are needed to create, retrieve, update, and delete chat sessions, verifying user ownership for operations on individual sessions.  Additionally, there will be an endpoint for sending messages within a session, which requires authentication.\n\n\n","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"import { Request, Response, NextFunction } from 'express';\nimport { Types } from 'mongoose';\nimport { ChatSession, ChatMessage } from './chat.model';\nimport { getLLMProvider } from '../../integrations/llm';\nimport { NotFoundError, UnauthorizedError, ForbiddenError } from '../../utils/errors';\n\nexport const createSession = async (req: Request, res: Response, next: NextFunction): Promise<void> => {\n  try {\n    if (!req.user) throw new UnauthorizedError();\n    const { title } = req.body;\n\n    const session = new ChatSession({\n      userId: new Types.ObjectId(req.user.userId),\n      title: title || 'New Career Conversation'\n    });\n    await session.save();\n\n    res.status(201).json({\n      success: true,\n      data: { session }\n    });\n  } catch (err) {\n    next(err);\n  }\n};\n\nexport const getSessions = async (req: Request, res: Response, next: NextFunction): Promise<void> => {\n  try {\n    if (!req.user) throw new UnauthorizedError();\n\n    const sessions = await ChatSession.find({ userId: req.user.userId })\n      .sort({ updatedAt: -1 });\n\n    res.status(200).json({\n      success: true,\n      data: { sessions }\n    });\n  } catch (err) {\n    next(err);\n  }\n};\n\nexport const getSession = async (req: Request, res: Response, next: NextFunction): Promise<void> => {\n  try {\n    if (!req.user) throw new UnauthorizedError();\n    const { sessionId } = req.params;\n\n    const session = await ChatSession.findById(sessionId);\n    if (!session) {\n      throw new NotFoundError('Chat session not found');\n    }\n\n    if (session.userId.toString() !== req.user.userId) {\n      throw new ForbiddenError('You are not authorized to view this chat session');\n    }\n\n    const messages = await ChatMessage.find({ sessionId })\n      .sort({ createdAt: 1 });\n\n    res.status(200).json({\n      success: true,\n      data: {\n        session,\n        messages\n      }\n    });\n  } catch (err) {\n    next(err);\n  }\n};\n\nexport const updateSession = async (req: Request, res: Response, next: NextFunction): Promise<void> => {\n  try {\n    if (!req.user) throw new UnauthorizedError();\n    const { sessionId } = req.params;\n    const { title } = req.body;\n\n    const session = await ChatSession.findById(sessionId);\n    if (!session) {\n      throw new NotFoundError('Chat session not found');\n    }\n\n    if (session.userId.toString() !== req.user.userId) {\n      throw new ForbiddenError('You are not authorized to modify this chat session');\n    }\n\n    session.title = title;\n    await session.save();\n\n    res.status(200).json({\n      success: true,\n      message: 'Chat session renamed',\n      data: { session }\n    });\n  } catch (err) {\n    next(err);\n  }\n};\n\nexport const deleteSession = async (req: Request, res: Response, next: NextFunction): Promise<void> => {\n  try {\n    if (!req.user) throw new UnauthorizedError();\n    const { sessionId } = req.params;\n\n    const session = await ChatSession.findById(sessionId);\n    if (!session) {\n      throw new NotFoundError('Chat session not found');\n    }\n\n    if (session.userId.toString() !== req.user.userId) {\n      throw new ForbiddenError('You are not authorized to delete this chat session');\n    }\n\n    await ChatMessage.deleteMany({ sessionId });\n    await ChatSession.findByIdAndDelete(sessionId);\n\n    res.status(200).json({\n      success: true,\n      message: 'Chat session deleted successfully'\n    });\n  } catch (err) {\n    next(err);\n  }\n};\n\nexport const sendMessage = async (req: Request, res: Response, next: NextFunction): Promise<void> => {\n  try {\n    if (!req.user) throw new UnauthorizedError();\n    const { sessionId } = req.params;\n    const { content } = req.body;\n\n    const session = await ChatSession.findById(sessionId);\n    if (!session) {\n      throw new NotFoundError('Chat session not found');\n    }\n\n    if (session.userId.toString() !== req.user.userId) {\n      throw new ForbiddenError('You are not authorized to participate in this chat session');\n    }\n\n    // 1. Save user message\n    const userMessage = new ChatMessage({\n      sessionId: session._id,\n      userId: new Types.ObjectId(req.user.userId),\n      role: 'user',\n      content\n    });\n    await userMessage.save();\n\n    // 2. Fetch recent history for context\n    const recentMessages = await ChatMessage.find({ sessionId })\n      .sort({ createdAt: -1 })\n      .limit(10);\n    recentMessages.reverse();\n\n    const formattedHistory = recentMessages.map(m => ({\n      role: m.role,\n      content: m.content\n    }));\n\n    // 3. Call LLM provider\n    const llmProvider = getLLMProvider();\n    const aiResponseText = await llmProvider.generateResponse(formattedHistory);\n\n    // 4. Save AI response\n    const assistantMessage = new ChatMessage({\n      sessionId: session._id,\n      userId: new Types.ObjectId(req.user.userId),\n      role: 'assistant',\n      content: aiResponseText\n    });\n    await assistantMessage.save();\n\n    // 5. Update session title if default\n    if (session.title === 'New Career Conversation') {\n      const generatedTitle = content.slice(0, 35) + (content.length > 35 ? '...' : '');\n      session.title = generatedTitle;\n    }\n    session.updatedAt = new Date();\n    await session.save();\n\n    res.status(200).json({\n      success: true,\n      data: {\n        userMessage,\n        assistantMessage\n      }\n    });\n  } catch (err) {\n    next(err);\n  }\n};\n","Description":"Create chat session and messaging controllers with LLM integration","Overwrite":true,"TargetFile":"C:\\Users\\PRIYANKA\\.gemini\\antigravity\\scratch\\career-platform\\backend\\src\\modules\\chat\\chat.controller.ts","toolAction":"Writing backend/src/modules/chat/chat.controller.ts","toolSummary":"Create chat.controller.ts"}}]}
