{"step_index":273,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-10-13T13:18:58Z","thinking":"Payment success page content requires wrapping in `<Suspense>`. This provides a loading state while fetching and rendering the payment details, improving user experience. The fallback component displays a loading indicator within a dashboard layout during the loading state.\n\n\n","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"'use client';\n\nimport React, { Suspense, useEffect, useState } from 'react';\nimport { useSearchParams } from 'next/navigation';\nimport Link from 'next/link';\nimport { DashboardLayout } from '@/components/layout/DashboardLayout';\nimport { api } from '@/lib/api';\nimport { Card, CardContent } from '@/components/ui/Card';\nimport { Button } from '@/components/ui/Button';\nimport { Badge } from '@/components/ui/Badge';\nimport {\n  CheckCircle2,\n  Calendar,\n  Video,\n  Mail,\n  ArrowRight,\n  Loader2,\n  AlertCircle\n} from 'lucide-react';\nimport { formatCurrency } from '@/lib/utils';\n\nfunction PaymentSuccessContent() {\n  const searchParams = useSearchParams();\n  const sessionId = searchParams.get('session_id');\n  const bookingId = searchParams.get('booking_id');\n\n  const [loading, setLoading] = useState(true);\n  const [data, setData] = useState<any>(null);\n  const [error, setError] = useState<string | null>(null);\n\n  useEffect(() => {\n    if (sessionId || bookingId) {\n      api.getPaymentStatus(bookingId || undefined, sessionId || undefined)\n        .then((res) => {\n          if (res?.data) {\n            setData(res.data);\n          }\n        })\n        .catch((err) => {\n          console.error('Failed to verify payment status:', err);\n          setError(err.message || 'Could not verify payment status from backend server.');\n        })\n        .finally(() => setLoading(false));\n    } else {\n      setLoading(false);\n    }\n  }, [sessionId, bookingId]);\n\n  return (\n    <DashboardLayout>\n      <div className=\"max-w-xl mx-auto py-8\">\n        <Card className=\"text-center shadow-lg border-emerald-100\">\n          <CardContent className=\"p-8 space-y-6\">\n            {loading ? (\n              <div className=\"py-12 space-y-3\">\n                <Loader2 className=\"w-10 h-10 animate-spin text-blue-600 mx-auto\" />\n                <p className=\"text-sm text-slate-500 font-medium\">Verifying payment with backend database...</p>\n              </div>\n            ) : error ? (\n              <div className=\"py-8 space-y-4\">\n                <div className=\"w-12 h-12 rounded-full bg-amber-50 text-amber-600 flex items-center justify-center mx-auto\">\n                  <AlertCircle className=\"w-7 h-7\" />\n                </div>\n                <h2 className=\"text-xl font-bold text-slate-900\">Payment Status Verification</h2>\n                <p className=\"text-xs text-slate-500\">{error}</p>\n                <Link href=\"/consultations\">\n                  <Button variant=\"outline\" className=\"mt-4\">Go to My Consultations</Button>\n                </Link>\n              </div>\n            ) : (\n              <>\n                <div className=\"w-16 h-16 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center mx-auto\">\n                  <CheckCircle2 className=\"w-10 h-10\" />\n                </div>\n\n                <div>\n                  <h1 className=\"text-2xl font-extrabold text-slate-900\">Payment Confirmed!</h1>\n                  <p className=\"text-sm text-slate-500 mt-1\">\n                    Your career consultation booking has been verified and confirmed.\n                  </p>\n                </div>\n\n                {data?.booking && (\n                  <div className=\"bg-slate-50 rounded-xl p-5 border border-slate-200 text-left space-y-3 text-xs\">\n                    <div className=\"flex justify-between items-center pb-2 border-b border-slate-200\">\n                      <span className=\"font-semibold text-slate-700\">Booking Status:</span>\n                      <Badge variant=\"success\">{data.booking.status}</Badge>\n                    </div>\n\n                    <div className=\"flex justify-between items-center\">\n                      <span className=\"text-slate-500\">Consultant:</span>\n                      <span className=\"font-semibold text-slate-900\">{data.booking.consultantId?.name}</span>\n                    </div>\n\n                    <div className=\"flex justify-between items-center\">\n                      <span className=\"text-slate-500\">Date & Time:</span>\n                      <span className=\"font-semibold text-slate-900\">\n                        {new Date(data.booking.startTime).toLocaleString()}\n                      </span>\n                    </div>\n\n                    <div className=\"flex justify-between items-center\">\n                      <span className=\"text-slate-500\">Amount Paid:</span>\n                      <span className=\"font-semibold text-slate-900\">\n                        {formatCurrency(data.amount, data.currency)}\n                      </span>\n                    </div>\n\n                    {data.booking.meetingUrl && (\n                      <div className=\"pt-2\">\n                        <a\n                          href={data.booking.meetingUrl}\n                          target=\"_blank\"\n                          rel=\"noreferrer\"\n                          className=\"flex items-center justify-center gap-2 p-2.5 rounded-lg bg-blue-600 text-white font-bold hover:bg-blue-700 transition-colors\"\n                        >\n                          <Video className=\"w-4 h-4\" /> Join Video Meeting\n                        </a>\n                      </div>\n                    )}\n                  </div>\n                )}\n\n                <div className=\"flex items-center justify-center gap-2 text-xs text-slate-400\">\n                  <Mail className=\"w-4 h-4\" />\n                  <span>A confirmation email with calendar details has been dispatched.</span>\n                </div>\n\n                <div className=\"pt-2\">\n                  <Link href=\"/consultations\">\n                    <Button size=\"lg\" className=\"w-full gap-2\">\n                      View My Consultations <ArrowRight className=\"w-4 h-4\" />\n                    </Button>\n                  </Link>\n                </div>\n              </>\n            )}\n          </CardContent>\n        </Card>\n      </div>\n    </DashboardLayout>\n  );\n}\n\nexport default function PaymentSuccessPage() {\n  return (\n    <Suspense\n      fallback={\n        <DashboardLayout>\n          <div className=\"h-64 flex items-center justify-center\">\n            <Loader2 className=\"w-8 h-8 animate-spin text-blue-600\" />\n          </div>\n        </DashboardLayout>\n      }\n    >\n      <PaymentSuccessContent />\n    </Suspense>\n  );\n}\n","Description":"Wrap useSearchParams in Suspense boundary for Next.js static prerender","Overwrite":true,"TargetFile":"C:\\Users\\PRIYANKA\\.gemini\\antigravity\\scratch\\career-platform\\frontend\\app\\payment\\success\\page.tsx","toolAction":"Writing frontend/app/payment/success/page.tsx","toolSummary":"Fix Suspense in payment/success/page.tsx"}}]}
