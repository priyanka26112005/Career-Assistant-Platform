{"step_index":228,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-10-13T13:09:46Z","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"'use client';\n\nimport React from 'react';\nimport Link from 'next/link';\nimport {\n  Sparkles,\n  BotMessageSquare,\n  FileCheck2,\n  CalendarCheck,\n  ShieldCheck,\n  ArrowRight,\n  Briefcase,\n  CheckCircle2\n} from 'lucide-react';\nimport { Button } from '@/components/ui/Button';\n\nexport default function LandingPage() {\n  return (\n    <div className=\"min-h-screen bg-slate-50 flex flex-col\">\n      {/* Public Navigation */}\n      <header className=\"h-20 border-b border-slate-200 bg-white/90 backdrop-blur-md sticky top-0 z-50\">\n        <div className=\"max-w-7xl mx-auto px-6 h-full flex items-center justify-between\">\n          <div className=\"flex items-center gap-3\">\n            <div className=\"w-10 h-10 rounded-xl bg-blue-600 flex items-center justify-center text-white shadow-md\">\n              <Briefcase className=\"w-6 h-6\" />\n            </div>\n            <span className=\"text-xl font-bold tracking-tight text-slate-900\">CareerOS</span>\n          </div>\n          <div className=\"flex items-center gap-4\">\n            <Link href=\"/login\">\n              <Button variant=\"ghost\">Sign In</Button>\n            </Link>\n            <Link href=\"/register\">\n              <Button variant=\"primary\">Get Started Free</Button>\n            </Link>\n          </div>\n        </div>\n      </header>\n\n      {/* Hero Section */}\n      <section className=\"py-20 lg:py-28 px-6 max-w-7xl mx-auto text-center\">\n        <div className=\"inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-blue-50 border border-blue-200 text-blue-700 text-xs font-semibold mb-8\">\n          <Sparkles className=\"w-4 h-4 text-blue-600\" />\n          The Modern AI-Powered Career Platform\n        </div>\n        <h1 className=\"text-4xl sm:text-6xl font-extrabold tracking-tight text-slate-900 max-w-4xl mx-auto leading-tight sm:leading-none\">\n          Accelerate your career with <span className=\"text-blue-600\">AI Intelligence</span> & verified industry experts.\n        </h1>\n        <p className=\"mt-6 text-lg sm:text-xl text-slate-600 max-w-2xl mx-auto\">\n          Craft high-scoring ATS resumes, practice behavioral loops with an AI Career Coach, and book 1-on-1 consultations with Big Tech hiring managers.\n        </p>\n        <div className=\"mt-10 flex flex-wrap justify-center gap-4\">\n          <Link href=\"/register\">\n            <Button size=\"lg\" className=\"shadow-lg shadow-blue-500/20\">\n              Start Your Free Journey <ArrowRight className=\"w-5 h-5 ml-2\" />\n            </Button>\n          </Link>\n          <Link href=\"/login\">\n            <Button size=\"lg\" variant=\"outline\">\n              Sign In to Dashboard\n            </Button>\n          </Link>\n        </div>\n      </section>\n\n      {/* Feature Grid */}\n      <section className=\"py-16 bg-white border-y border-slate-200\">\n        <div className=\"max-w-7xl mx-auto px-6\">\n          <div className=\"text-center max-w-2xl mx-auto mb-16\">\n            <h2 className=\"text-3xl font-bold text-slate-900\">Engineered for High-Impact Careers</h2>\n            <p className=\"text-slate-500 mt-3\">All the tools required to land top engineering, product, and leadership roles.</p>\n          </div>\n\n          <div className=\"grid md:grid-cols-3 gap-8\">\n            <div className=\"p-8 rounded-2xl bg-slate-50 border border-slate-200 space-y-4\">\n              <div className=\"w-12 h-12 rounded-xl bg-blue-100 flex items-center justify-center text-blue-600\">\n                <FileCheck2 className=\"w-6 h-6\" />\n              </div>\n              <h3 className=\"text-xl font-bold text-slate-900\">AI Resume Builder</h3>\n              <p className=\"text-sm text-slate-600 leading-relaxed\">\n                Generate tailored summaries, bullet points, and competencies. Switch seamlessly between ATS-Classic and Modern-Professional templates without losing data.\n              </p>\n            </div>\n\n            <div className=\"p-8 rounded-2xl bg-slate-50 border border-slate-200 space-y-4\">\n              <div className=\"w-12 h-12 rounded-xl bg-emerald-100 flex items-center justify-center text-emerald-600\">\n                <BotMessageSquare className=\"w-6 h-6\" />\n              </div>\n              <h3 className=\"text-xl font-bold text-slate-900\">AI Career Assistant</h3>\n              <p className=\"text-sm text-slate-600 leading-relaxed\">\n                Persistent multi-turn conversation sessions. Prepare for technical interviews, practice behavioral STAR responses, and master salary negotiations.\n              </p>\n            </div>\n\n            <div className=\"p-8 rounded-2xl bg-slate-50 border border-slate-200 space-y-4\">\n              <div className=\"w-12 h-12 rounded-xl bg-purple-100 flex items-center justify-center text-purple-600\">\n                <CalendarCheck className=\"w-6 h-6\" />\n              </div>\n              <h3 className=\"text-xl font-bold text-slate-900\">Expert 1-on-1 Consultations</h3>\n              <p className=\"text-sm text-slate-600 leading-relaxed\">\n                Real-time booking with verified consultants. Powered by Stripe checkout, automatic Google Calendar invitations, and email confirmations.\n              </p>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      {/* Trust & Security */}\n      <section className=\"py-16 px-6 max-w-7xl mx-auto w-full\">\n        <div className=\"flex flex-col md:flex-row items-center justify-between gap-8 p-8 rounded-2xl bg-blue-600 text-white shadow-xl\">\n          <div className=\"space-y-2\">\n            <h3 className=\"text-2xl font-bold flex items-center gap-2\">\n              <ShieldCheck className=\"w-7 h-7\" /> Production-Grade Architecture\n            </h3>\n            <p className=\"text-blue-100 max-w-xl text-sm\">\n              Role-based access control, cryptographic Stripe webhook verification, resilient concurrency safeguards, and isolated user data scoping.\n            </p>\n          </div>\n          <Link href=\"/register\">\n            <Button size=\"lg\" className=\"bg-white text-blue-700 hover:bg-blue-50 shadow-md\">\n              Create Your Free Account\n            </Button>\n          </Link>\n        </div>\n      </section>\n\n      {/* Footer */}\n      <footer className=\"mt-auto border-t border-slate-200 bg-white py-8 text-center text-xs text-slate-500\">\n        <p>© 2026 CareerOS Inc. All rights reserved. Built with Next.js, Express, MongoDB, and Tailwind CSS.</p>\n      </footer>\n    </div>\n  );\n}\n","Description":"Create public landing page component","Overwrite":true,"TargetFile":"C:\\Users\\PRIYANKA\\.gemini\\antigravity\\scratch\\career-platform\\frontend\\app\\page.tsx","toolAction":"Writing frontend/app/page.tsx","toolSummary":"Create page.tsx"}}]}
