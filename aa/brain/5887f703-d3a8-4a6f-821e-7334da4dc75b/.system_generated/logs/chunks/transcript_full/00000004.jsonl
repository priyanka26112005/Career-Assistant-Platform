{"step_index":238,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-10-13T13:10:55Z","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"'use client';\n\nimport React, { useEffect, useState } from 'react';\nimport { DashboardLayout } from '@/components/layout/DashboardLayout';\nimport { api } from '@/lib/api';\nimport { IUser } from '@/types';\nimport { Card, CardHeader, CardTitle, CardDescription, CardContent } from '@/components/ui/Card';\nimport { Button } from '@/components/ui/Button';\nimport { Input } from '@/components/ui/Input';\nimport { Badge } from '@/components/ui/Badge';\nimport { CheckCircle2, Plus, Trash2 } from 'lucide-react';\n\nexport default function ProfilePage() {\n  const [user, setUser] = useState<IUser | null>(null);\n  const [isLoading, setIsLoading] = useState(true);\n  const [isSaving, setIsSaving] = useState(false);\n  const [saveSuccess, setSaveSuccess] = useState(false);\n  const [newSkill, setNewSkill] = useState('');\n\n  // Form states\n  const [name, setName] = useState('');\n  const [phone, setPhone] = useState('');\n  const [headline, setHeadline] = useState('');\n  const [bio, setBio] = useState('');\n  const [skills, setSkills] = useState<string[]>([]);\n\n  useEffect(() => {\n    api.getProfile()\n      .then((res) => {\n        if (res?.data) {\n          const u = res.data;\n          setUser(u);\n          setName(u.name || '');\n          setPhone(u.profile?.phone || '');\n          setHeadline(u.profile?.headline || '');\n          setBio(u.profile?.bio || '');\n          setSkills(u.profile?.skills || []);\n        }\n      })\n      .catch((err) => console.error(err))\n      .finally(() => setIsLoading(false));\n  }, []);\n\n  const handleAddSkill = () => {\n    if (newSkill.trim() && !skills.includes(newSkill.trim())) {\n      setSkills([...skills, newSkill.trim()]);\n      setNewSkill('');\n    }\n  };\n\n  const handleRemoveSkill = (skillToRemove: string) => {\n    setSkills(skills.filter(s => s !== skillToRemove));\n  };\n\n  const handleSave = async (e: React.FormEvent) => {\n    e.preventDefault();\n    setIsSaving(true);\n    setSaveSuccess(false);\n\n    try {\n      await api.updateProfile({\n        name,\n        phone,\n        headline,\n        bio,\n        skills,\n      });\n      setSaveSuccess(true);\n      setTimeout(() => setSaveSuccess(false), 3000);\n    } catch (err) {\n      console.error('Failed to update profile:', err);\n    } finally {\n      setIsSaving(false);\n    }\n  };\n\n  return (\n    <DashboardLayout>\n      <div className=\"max-w-4xl space-y-8\">\n        <div>\n          <h1 className=\"text-2xl font-bold tracking-tight text-slate-900\">Personal & Professional Profile</h1>\n          <p className=\"text-sm text-slate-500 mt-1\">\n            Manage your personal contact details, bio, and technical skills used by the AI resume engine.\n          </p>\n        </div>\n\n        {saveSuccess && (\n          <div className=\"p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm flex items-center gap-2\">\n            <CheckCircle2 className=\"w-5 h-5 text-emerald-600 flex-shrink-0\" />\n            <span>Profile changes saved successfully!</span>\n          </div>\n        )}\n\n        <form onSubmit={handleSave} className=\"space-y-6\">\n          <Card>\n            <CardHeader>\n              <CardTitle className=\"text-base\">Basic Information</CardTitle>\n              <CardDescription>Your public identity and contact details</CardDescription>\n            </CardHeader>\n            <CardContent className=\"space-y-4\">\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n                <Input\n                  label=\"Full Name\"\n                  value={name}\n                  onChange={(e) => setName(e.target.value)}\n                  placeholder=\"e.g. Alice Johnson\"\n                  required\n                />\n                <Input\n                  label=\"Email Address (Login ID)\"\n                  value={user?.email || ''}\n                  disabled\n                  helperText=\"Email cannot be changed\"\n                />\n              </div>\n\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n                <Input\n                  label=\"Phone Number\"\n                  value={phone}\n                  onChange={(e) => setPhone(e.target.value)}\n                  placeholder=\"+1 (555) 000-0000\"\n                />\n                <Input\n                  label=\"Professional Headline\"\n                  value={headline}\n                  onChange={(e) => setHeadline(e.target.value)}\n                  placeholder=\"Senior Software Engineer | Cloud Architect\"\n                />\n              </div>\n\n              <div>\n                <label className=\"block text-sm font-medium text-slate-700 mb-1.5\">Biography & Summary</label>\n                <textarea\n                  rows={4}\n                  value={bio}\n                  onChange={(e) => setBio(e.target.value)}\n                  placeholder=\"Briefly describe your career journey, leadership style, and key achievements...\"\n                  className=\"w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 placeholder:text-slate-400 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500\"\n                />\n              </div>\n            </CardContent>\n          </Card>\n\n          <Card>\n            <CardHeader>\n              <CardTitle className=\"text-base\">Skills & Competencies</CardTitle>\n              <CardDescription>Technical tools, methodologies, and frameworks</CardDescription>\n            </CardHeader>\n            <CardContent className=\"space-y-4\">\n              <div className=\"flex gap-2\">\n                <Input\n                  value={newSkill}\n                  onChange={(e) => setNewSkill(e.target.value)}\n                  placeholder=\"Add skill (e.g. Next.js, Kubernetes, PostgreSQL)\"\n                  onKeyDown={(e) => {\n                    if (e.key === 'Enter') {\n                      e.preventDefault();\n                      handleAddSkill();\n                    }\n                  }}\n                />\n                <Button type=\"button\" onClick={handleAddSkill} variant=\"secondary\" className=\"gap-1 flex-shrink-0\">\n                  <Plus className=\"w-4 h-4\" /> Add\n                </Button>\n              </div>\n\n              <div className=\"flex flex-wrap gap-2 pt-2\">\n                {skills.length === 0 ? (\n                  <p className=\"text-xs text-slate-400\">No skills added yet.</p>\n                ) : (\n                  skills.map((skill) => (\n                    <span\n                      key={skill}\n                      className=\"inline-flex items-center gap-1.5 rounded-lg bg-blue-50 border border-blue-200 px-3 py-1 text-xs font-semibold text-blue-700\"\n                    >\n                      {skill}\n                      <button\n                        type=\"button\"\n                        onClick={() => handleRemoveSkill(skill)}\n                        className=\"hover:text-red-600 transition-colors\"\n                      >\n                        <Trash2 className=\"w-3 h-3\" />\n                      </button>\n                    </span>\n                  ))\n                )}\n              </div>\n            </CardContent>\n          </Card>\n\n          <div className=\"flex justify-end\">\n            <Button type=\"submit\" size=\"lg\" isLoading={isSaving} className=\"w-full sm:w-auto\">\n              Save Profile Changes\n            </Button>\n          </div>\n        </form>\n      </div>\n    </DashboardLayout>\n  );\n}\n","Description":"Create user Profile management page component","Overwrite":true,"TargetFile":"C:\\Users\\PRIYANKA\\.gemini\\antigravity\\scratch\\career-platform\\frontend\\app\\profile\\page.tsx","toolAction":"Writing frontend/app/profile/page.tsx","toolSummary":"Create profile/page.tsx"}}]}
