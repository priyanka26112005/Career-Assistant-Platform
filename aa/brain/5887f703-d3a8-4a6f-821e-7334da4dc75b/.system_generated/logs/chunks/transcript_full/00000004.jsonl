{"step_index":224,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-10-13T13:09:00Z","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"'use client';\n\nimport React from 'react';\nimport { IResume, ResumeTemplateType } from '@/types';\nimport { Mail, Phone, MapPin, Globe, Linkedin } from 'lucide-react';\n\nexport interface ResumePreviewProps {\n  resume: IResume;\n  templateOverride?: ResumeTemplateType;\n}\n\nexport const ResumePreview: React.FC<ResumePreviewProps> = ({ resume, templateOverride }) => {\n  const currentTemplate = templateOverride || resume.template || 'MODERN_PROFESSIONAL';\n  const p = resume.personalInfo || { fullName: '', email: '' };\n\n  if (currentTemplate === 'ATS_CLASSIC') {\n    return (\n      <div className=\"w-full bg-white p-8 sm:p-12 border border-slate-200 shadow-sm font-serif text-slate-900 leading-normal max-w-4xl mx-auto\">\n        {/* ATS Header */}\n        <header className=\"text-center pb-4 mb-6 border-b border-black\">\n          <h1 className=\"text-2xl font-bold uppercase tracking-wide text-black\">{p.fullName || 'Full Name'}</h1>\n          <div className=\"text-xs text-black mt-2 flex flex-wrap justify-center gap-x-3 gap-y-1\">\n            {p.location && <span>{p.location}</span>}\n            {p.phone && <span>• {p.phone}</span>}\n            {p.email && <span>• {p.email}</span>}\n            {p.linkedin && <span>• {p.linkedin}</span>}\n            {p.website && <span>• {p.website}</span>}\n          </div>\n        </header>\n\n        {/* ATS Summary */}\n        {resume.summary && (\n          <section className=\"mb-5\">\n            <h2 className=\"text-sm font-bold uppercase tracking-wider border-b border-black pb-1 mb-2\">\n              Professional Summary\n            </h2>\n            <div\n              className=\"text-xs text-justify text-slate-800 leading-relaxed\"\n              dangerouslySetInnerHTML={{ __html: resume.summary }}\n            />\n          </section>\n        )}\n\n        {/* ATS Experience */}\n        {resume.experience && resume.experience.length > 0 && (\n          <section className=\"mb-5\">\n            <h2 className=\"text-sm font-bold uppercase tracking-wider border-b border-black pb-1 mb-2\">\n              Professional Experience\n            </h2>\n            <div className=\"space-y-4\">\n              {resume.experience.map((exp, idx) => (\n                <div key={exp.id || idx}>\n                  <div className=\"flex justify-between text-xs font-bold text-black\">\n                    <span>{exp.company}</span>\n                    <span>{exp.location || ''}</span>\n                  </div>\n                  <div className=\"flex justify-between text-xs italic text-slate-800 mb-1\">\n                    <span>{exp.role}</span>\n                    <span>{exp.startDate} - {exp.current ? 'Present' : exp.endDate}</span>\n                  </div>\n                  {exp.description && (\n                    <div\n                      className=\"text-xs text-slate-800 mb-1.5 leading-relaxed\"\n                      dangerouslySetInnerHTML={{ __html: exp.description }}\n                    />\n                  )}\n                  {exp.highlights && exp.highlights.length > 0 && (\n                    <ul className=\"list-disc list-inside text-xs text-slate-800 space-y-0.5 ml-1\">\n                      {exp.highlights.map((h, hIdx) => (\n                        <li key={hIdx}>{h}</li>\n                      ))}\n                    </ul>\n                  )}\n                </div>\n              ))}\n            </div>\n          </section>\n        )}\n\n        {/* ATS Skills */}\n        {resume.skills && resume.skills.length > 0 && (\n          <section className=\"mb-5\">\n            <h2 className=\"text-sm font-bold uppercase tracking-wider border-b border-black pb-1 mb-2\">\n              Technical & Professional Skills\n            </h2>\n            <p className=\"text-xs text-slate-800\">\n              <strong className=\"text-black\">Core Competencies: </strong>\n              {resume.skills.join(', ')}\n            </p>\n          </section>\n        )}\n\n        {/* ATS Education */}\n        {resume.education && resume.education.length > 0 && (\n          <section className=\"mb-5\">\n            <h2 className=\"text-sm font-bold uppercase tracking-wider border-b border-black pb-1 mb-2\">\n              Education\n            </h2>\n            <div className=\"space-y-2\">\n              {resume.education.map((edu, idx) => (\n                <div key={edu.id || idx}>\n                  <div className=\"flex justify-between text-xs font-bold text-black\">\n                    <span>{edu.institution}</span>\n                    <span>{edu.startDate} - {edu.endDate}</span>\n                  </div>\n                  <div className=\"text-xs text-slate-800\">\n                    {edu.degree} {edu.fieldOfStudy && `in ${edu.fieldOfStudy}`} {edu.gpa && `(GPA: ${edu.gpa})`}\n                  </div>\n                </div>\n              ))}\n            </div>\n          </section>\n        )}\n\n        {/* ATS Projects */}\n        {resume.projects && resume.projects.length > 0 && (\n          <section className=\"mb-5\">\n            <h2 className=\"text-sm font-bold uppercase tracking-wider border-b border-black pb-1 mb-2\">\n              Projects\n            </h2>\n            <div className=\"space-y-2\">\n              {resume.projects.map((proj, idx) => (\n                <div key={proj.id || idx}>\n                  <div className=\"flex justify-between text-xs font-bold text-black\">\n                    <span>{proj.title}</span>\n                    <span className=\"font-normal italic\">{proj.technologies?.join(', ')}</span>\n                  </div>\n                  <p className=\"text-xs text-slate-800\">{proj.description}</p>\n                </div>\n              ))}\n            </div>\n          </section>\n        )}\n\n        {/* ATS Certifications */}\n        {resume.certifications && resume.certifications.length > 0 && (\n          <section className=\"mb-5\">\n            <h2 className=\"text-sm font-bold uppercase tracking-wider border-b border-black pb-1 mb-2\">\n              Certifications\n            </h2>\n            <ul className=\"list-disc list-inside text-xs text-slate-800 space-y-0.5\">\n              {resume.certifications.map((c, idx) => (\n                <li key={c.id || idx}>\n                  <strong>{c.name}</strong> {c.issuer && `– ${c.issuer}`} {c.issueDate && `(${c.issueDate})`}\n                </li>\n              ))}\n            </ul>\n          </section>\n        )}\n\n        {/* ATS Achievements */}\n        {resume.achievements && resume.achievements.length > 0 && (\n          <section className=\"mb-5\">\n            <h2 className=\"text-sm font-bold uppercase tracking-wider border-b border-black pb-1 mb-2\">\n              Honors & Achievements\n            </h2>\n            <ul className=\"list-disc list-inside text-xs text-slate-800 space-y-0.5\">\n              {resume.achievements.map((a, idx) => (\n                <li key={idx}>{a}</li>\n              ))}\n            </ul>\n          </section>\n        )}\n      </div>\n    );\n  }\n\n  // MODERN PROFESSIONAL TEMPLATE\n  return (\n    <div className=\"w-full bg-white p-8 sm:p-12 border border-slate-200 shadow-sm font-sans text-slate-800 leading-relaxed max-w-4xl mx-auto rounded-lg\">\n      {/* Modern Header */}\n      <header className=\"border-b-2 border-blue-600 pb-5 mb-6\">\n        <h1 className=\"text-3xl font-extrabold tracking-tight text-slate-900\">{p.fullName || 'Your Full Name'}</h1>\n        <div className=\"mt-3 flex flex-wrap gap-4 text-xs font-medium text-slate-600\">\n          {p.email && (\n            <span className=\"flex items-center gap-1.5\">\n              <Mail className=\"w-3.5 h-3.5 text-blue-600\" />\n              {p.email}\n            </span>\n          )}\n          {p.phone && (\n            <span className=\"flex items-center gap-1.5\">\n              <Phone className=\"w-3.5 h-3.5 text-blue-600\" />\n              {p.phone}\n            </span>\n          )}\n          {p.location && (\n            <span className=\"flex items-center gap-1.5\">\n              <MapPin className=\"w-3.5 h-3.5 text-blue-600\" />\n              {p.location}\n            </span>\n          )}\n          {p.linkedin && (\n            <span className=\"flex items-center gap-1.5\">\n              <Linkedin className=\"w-3.5 h-3.5 text-blue-600\" />\n              {p.linkedin}\n            </span>\n          )}\n          {p.website && (\n            <span className=\"flex items-center gap-1.5\">\n              <Globe className=\"w-3.5 h-3.5 text-blue-600\" />\n              {p.website}\n            </span>\n          )}\n        </div>\n      </header>\n\n      {/* Summary */}\n      {resume.summary && (\n        <section className=\"mb-6\">\n          <h2 className=\"text-xs font-bold uppercase tracking-wider text-blue-700 border-b border-slate-200 pb-1.5 mb-2.5\">\n            Professional Summary\n          </h2>\n          <div\n            className=\"text-sm text-slate-700 leading-relaxed\"\n            dangerouslySetInnerHTML={{ __html: resume.summary }}\n          />\n        </section>\n      )}\n\n      {/* Experience */}\n      {resume.experience && resume.experience.length > 0 && (\n        <section className=\"mb-6\">\n          <h2 className=\"text-xs font-bold uppercase tracking-wider text-blue-700 border-b border-slate-200 pb-1.5 mb-3\">\n            Experience\n          </h2>\n          <div className=\"space-y-4\">\n            {resume.experience.map((exp, idx) => (\n              <div key={exp.id || idx} className=\"space-y-1\">\n                <div className=\"flex justify-between items-baseline\">\n                  <span className=\"text-sm font-semibold text-slate-900\">\n                    {exp.role} <span className=\"text-slate-500 font-normal\">• {exp.company}</span>\n                  </span>\n                  <span className=\"text-xs text-slate-500 font-medium\">\n                    {exp.startDate} – {exp.current ? 'Present' : exp.endDate}\n                  </span>\n                </div>\n                {exp.location && <p className=\"text-xs text-slate-400\">{exp.location}</p>}\n                {exp.description && (\n                  <div\n                    className=\"text-xs text-slate-700 leading-relaxed\"\n                    dangerouslySetInnerHTML={{ __html: exp.description }}\n                  />\n                )}\n                {exp.highlights && exp.highlights.length > 0 && (\n                  <ul className=\"list-disc list-inside text-xs text-slate-700 space-y-1 ml-1 mt-1.5\">\n                    {exp.highlights.map((h, hIdx) => (\n                      <li key={hIdx}>{h}</li>\n                    ))}\n                  </ul>\n                )}\n              </div>\n            ))}\n          </div>\n        </section>\n      )}\n\n      {/* Skills */}\n      {resume.skills && resume.skills.length > 0 && (\n        <section className=\"mb-6\">\n          <h2 className=\"text-xs font-bold uppercase tracking-wider text-blue-700 border-b border-slate-200 pb-1.5 mb-2.5\">\n            Skills & Competencies\n          </h2>\n          <div className=\"flex flex-wrap gap-1.5\">\n            {resume.skills.map((skill, idx) => (\n              <span\n                key={idx}\n                className=\"inline-block rounded bg-slate-100 border border-slate-200 px-2.5 py-1 text-xs font-medium text-slate-800\"\n              >\n                {skill}\n              </span>\n            ))}\n          </div>\n        </section>\n      )}\n\n      {/* Education */}\n      {resume.education && resume.education.length > 0 && (\n        <section className=\"mb-6\">\n          <h2 className=\"text-xs font-bold uppercase tracking-wider text-blue-700 border-b border-slate-200 pb-1.5 mb-2.5\">\n            Education\n          </h2>\n          <div className=\"space-y-2\">\n            {resume.education.map((edu, idx) => (\n              <div key={edu.id || idx} className=\"flex justify-between items-baseline\">\n                <div>\n                  <p className=\"text-sm font-semibold text-slate-900\">{edu.degree} {edu.fieldOfStudy && `in ${edu.fieldOfStudy}`}</p>\n                  <p className=\"text-xs text-slate-600\">{edu.institution} {edu.gpa && `• GPA: ${edu.gpa}`}</p>\n                </div>\n                <span className=\"text-xs text-slate-500 font-medium\">{edu.startDate} – {edu.endDate}</span>\n              </div>\n            ))}\n          </div>\n        </section>\n      )}\n\n      {/* Projects */}\n      {resume.projects && resume.projects.length > 0 && (\n        <section className=\"mb-6\">\n          <h2 className=\"text-xs font-bold uppercase tracking-wider text-blue-700 border-b border-slate-200 pb-1.5 mb-2.5\">\n            Key Projects\n          </h2>\n          <div className=\"space-y-2.5\">\n            {resume.projects.map((proj, idx) => (\n              <div key={proj.id || idx}>\n                <div className=\"flex justify-between items-baseline\">\n                  <span className=\"text-sm font-semibold text-slate-900\">{proj.title}</span>\n                  {proj.link && <a href={proj.link} target=\"_blank\" rel=\"noreferrer\" className=\"text-xs text-blue-600 hover:underline\">Link</a>}\n                </div>\n                <p className=\"text-xs text-slate-700\">{proj.description}</p>\n                {proj.technologies && proj.technologies.length > 0 && (\n                  <p className=\"text-[11px] text-slate-500 mt-0.5\">Tech: {proj.technologies.join(', ')}</p>\n                )}\n              </div>\n            ))}\n          </div>\n        </section>\n      )}\n\n      {/* Certifications */}\n      {resume.certifications && resume.certifications.length > 0 && (\n        <section className=\"mb-6\">\n          <h2 className=\"text-xs font-bold uppercase tracking-wider text-blue-700 border-b border-slate-200 pb-1.5 mb-2.5\">\n            Certifications\n          </h2>\n          <div className=\"space-y-1.5\">\n            {resume.certifications.map((c, idx) => (\n              <div key={c.id || idx} className=\"text-xs text-slate-800\">\n                <span className=\"font-semibold text-slate-900\">{c.name}</span>\n                {c.issuer && <span className=\"text-slate-600\"> • {c.issuer}</span>}\n                {c.issueDate && <span className=\"text-slate-500\"> ({c.issueDate})</span>}\n              </div>\n            ))}\n          </div>\n        </section>\n      )}\n\n      {/* Achievements */}\n      {resume.achievements && resume.achievements.length > 0 && (\n        <section className=\"mb-6\">\n          <h2 className=\"text-xs font-bold uppercase tracking-wider text-blue-700 border-b border-slate-200 pb-1.5 mb-2.5\">\n            Achievements\n          </h2>\n          <ul className=\"list-disc list-inside text-xs text-slate-700 space-y-1\">\n            {resume.achievements.map((a, idx) => (\n              <li key={idx}>{a}</li>\n            ))}\n          </ul>\n        </section>\n      )}\n    </div>\n  );\n};\n","Description":"Create live resume preview renderer for Modern Professional and ATS Classic templates","Overwrite":true,"TargetFile":"C:\\Users\\PRIYANKA\\.gemini\\antigravity\\scratch\\career-platform\\frontend\\components\\templates\\ResumePreview.tsx","toolAction":"Writing frontend/components/templates/ResumePreview.tsx","toolSummary":"Create ResumePreview.tsx"}}]}
