{"step_index":202,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-10-13T13:07:01Z","thinking":"Constructing the API client involves defining the backend URL, defaulting to a local development address or an environment variable. The client needs to include credentials for HTTP-only cookie management and handle authorization tokens for authenticated requests. The API will support `auth` methods like login, registration, logout and fetching the current user, alongside `users` methods for getting and updating user profiles.\n\n\n","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"const BACKEND_URL = process.env.NEXT_PUBLIC_BACKEND_URL || 'http://localhost:5000';\n\nclass ApiClient {\n  private token: string | null = null;\n\n  constructor() {\n    if (typeof window !== 'undefined') {\n      this.token = sessionStorage.getItem('auth_token');\n    }\n  }\n\n  setToken(token: string | null) {\n    this.token = token;\n    if (typeof window !== 'undefined') {\n      if (token) {\n        sessionStorage.setItem('auth_token', token);\n      } else {\n        sessionStorage.removeItem('auth_token');\n      }\n    }\n  }\n\n  getToken(): string | null {\n    if (!this.token && typeof window !== 'undefined') {\n      this.token = sessionStorage.getItem('auth_token');\n    }\n    return this.token;\n  }\n\n  private async request<T>(endpoint: string, options: RequestInit = {}): Promise<T> {\n    const url = `${BACKEND_URL}${endpoint}`;\n    const token = this.getToken();\n\n    const headers: Record<string, string> = {\n      'Content-Type': 'application/json',\n      ...(options.headers as Record<string, string>),\n    };\n\n    if (token) {\n      headers['Authorization'] = `Bearer ${token}`;\n    }\n\n    const response = await fetch(url, {\n      ...options,\n      headers,\n      credentials: 'include', // Includes HTTP-only cookies\n    });\n\n    const data = await response.json().catch(() => ({}));\n\n    if (!response.ok) {\n      const errorMessage = data?.error?.message || response.statusText || 'Request failed';\n      throw new Error(errorMessage);\n    }\n\n    return data;\n  }\n\n  // AUTH\n  async register(body: any) {\n    const res = await this.request<any>('/api/auth/register', {\n      method: 'POST',\n      body: JSON.stringify(body),\n    });\n    if (res?.data?.token) {\n      this.setToken(res.data.token);\n    }\n    return res;\n  }\n\n  async login(body: any) {\n    const res = await this.request<any>('/api/auth/login', {\n      method: 'POST',\n      body: JSON.stringify(body),\n    });\n    if (res?.data?.token) {\n      this.setToken(res.data.token);\n    }\n    return res;\n  }\n\n  async logout() {\n    try {\n      await this.request('/api/auth/logout', { method: 'POST' });\n    } finally {\n      this.setToken(null);\n    }\n  }\n\n  async getMe() {\n    return this.request<any>('/api/auth/me');\n  }\n\n  // PROFILE\n  async getProfile() {\n    return this.request<any>('/api/users/profile');\n  }\n\n  async updateProfile(body: any) {\n    return this.request<any>('/api/users/profile', {\n      method: 'PATCH',\n      body: JSON.stringify(body),\n    });\n  }\n\n  // CHAT\n  async getChatSessions() {\n    return this.request<any>('/api/chat/sessions');\n  }\n\n  async createChatSession(title?: string) {\n    return this.request<any>('/api/chat/sessions', {\n      method: 'POST',\n      body: JSON.stringify({ title }),\n    });\n  }\n\n  async getChatSession(sessionId: string) {\n    return this.request<any>(`/api/chat/sessions/${sessionId}`);\n  }\n\n  async updateChatSession(sessionId: string, title: string) {\n    return this.request<any>(`/api/chat/sessions/${sessionId}`, {\n      method: 'PATCH',\n      body: JSON.stringify({ title }),\n    });\n  }\n\n  async deleteChatSession(sessionId: string) {\n    return this.request<any>(`/api/chat/sessions/${sessionId}`, {\n      method: 'DELETE',\n    });\n  }\n\n  async sendChatMessage(sessionId: string, content: string) {\n    return this.request<any>(`/api/chat/sessions/${sessionId}/messages`, {\n      method: 'POST',\n      body: JSON.stringify({ content }),\n    });\n  }\n\n  // RESUMES\n  async getResumes() {\n    return this.request<any>('/api/resumes');\n  }\n\n  async createResume(title: string, template: string) {\n    return this.request<any>('/api/resumes', {\n      method: 'POST',\n      body: JSON.stringify({ title, template }),\n    });\n  }\n\n  async getResume(id: string) {\n    return this.request<any>(`/api/resumes/${id}`);\n  }\n\n  async updateResume(id: string, body: any) {\n    return this.request<any>(`/api/resumes/${id}`, {\n      method: 'PATCH',\n      body: JSON.stringify(body),\n    });\n  }\n\n  async deleteResume(id: string) {\n    return this.request<any>(`/api/resumes/${id}`, {\n      method: 'DELETE',\n    });\n  }\n\n  async generateResumeSection(id: string, section: string, prompt: string) {\n    return this.request<any>(`/api/resumes/${id}/generate`, {\n      method: 'POST',\n      body: JSON.stringify({ section, prompt }),\n    });\n  }\n\n  async exportResume(id: string, template?: string) {\n    const query = template ? `?template=${template}` : '';\n    return this.request<any>(`/api/resumes/${id}/export${query}`);\n  }\n\n  // CONSULTANTS\n  async getConsultants(search?: string, expertise?: string) {\n    const params = new URLSearchParams();\n    if (search) params.append('search', search);\n    if (expertise) params.append('expertise', expertise);\n    return this.request<any>(`/api/consultants?${params.toString()}`);\n  }\n\n  async getConsultantById(id: string) {\n    return this.request<any>(`/api/consultants/${id}`);\n  }\n\n  async getConsultantAvailability(id: string, date: string) {\n    return this.request<any>(`/api/consultants/${id}/availability?date=${date}`);\n  }\n\n  // BOOKINGS\n  async getBookings(page = 1, limit = 10, status?: string, search?: string) {\n    const params = new URLSearchParams({ page: String(page), limit: String(limit) });\n    if (status) params.append('status', status);\n    if (search) params.append('search', search);\n    return this.request<any>(`/api/bookings?${params.toString()}`);\n  }\n\n  async createBooking(body: any) {\n    return this.request<any>('/api/bookings', {\n      method: 'POST',\n      body: JSON.stringify(body),\n    });\n  }\n\n  async cancelBooking(id: string) {\n    return this.request<any>(`/api/bookings/${id}/cancel`, {\n      method: 'PATCH',\n    });\n  }\n\n  // PAYMENTS\n  async createCheckoutSession(bookingId: string) {\n    return this.request<any>('/api/payments/checkout', {\n      method: 'POST',\n      body: JSON.stringify({ bookingId }),\n    });\n  }\n\n  async getPaymentStatus(bookingId?: string, sessionId?: string) {\n    const query = bookingId ? `/${bookingId}` : `?sessionId=${sessionId}`;\n    return this.request<any>(`/api/payments/status${query}`);\n  }\n\n  // DASHBOARD\n  async getDashboardMetrics() {\n    return this.request<any>('/api/dashboard');\n  }\n}\n\nexport const api = new ApiClient();\n","Description":"Create comprehensive frontend API client with session management","Overwrite":true,"TargetFile":"C:\\Users\\PRIYANKA\\.gemini\\antigravity\\scratch\\career-platform\\frontend\\lib\\api.ts","toolAction":"Writing frontend/lib/api.ts","toolSummary":"Create api.ts"}}]}
