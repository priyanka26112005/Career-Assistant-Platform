{"step_index":236,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-10-13T13:10:35Z","thinking":"Constructing the dashboard page requires fetching data from the `/api/dashboard` endpoint and displaying the returned statistics. Data retrieval involves calculating `totalResumes`, `totalChats`, `upcomingConsultations`, and `completedConsultations` from the database. A key consideration is handling cases where a user might have no data associated with their account.\n\n\n","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"'use client';\n\nimport React, { useEffect, useState } from 'react';\nimport Link from 'next/link';\nimport { DashboardLayout } from '@/components/layout/DashboardLayout';\nimport { api } from '@/lib/api';\nimport { IDashboardMetrics } from '@/types';\nimport { Card, CardHeader, CardTitle, CardContent } from '@/components/ui/Card';\nimport { Button } from '@/components/ui/Button';\nimport { Badge } from '@/components/ui/Badge';\nimport { Skeleton } from '@/components/ui/Skeleton';\nimport { formatDate } from '@/lib/utils';\nimport {\n  FileText,\n  BotMessageSquare,\n  CalendarCheck2,\n  CheckCircle,\n  Plus,\n  ArrowRight,\n  ExternalLink\n} from 'lucide-react';\n\nexport default function DashboardPage() {\n  const [metrics, setMetrics] = useState<IDashboardMetrics | null>(null);\n  const [loading, setLoading] = useState(true);\n\n  useEffect(() => {\n    api.getDashboardMetrics()\n      .then((res) => {\n        if (res?.data) {\n          setMetrics(res.data);\n        }\n      })\n      .catch((err) => {\n        console.error('Failed to load dashboard metrics:', err);\n      })\n      .finally(() => setLoading(false));\n  }, []);\n\n  return (\n    <DashboardLayout>\n      <div className=\"space-y-8\">\n        {/* Header */}\n        <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n          <div>\n            <h1 className=\"text-2xl font-bold tracking-tight text-slate-900\">Career Dashboard</h1>\n            <p className=\"text-sm text-slate-500 mt-1\">\n              Overview of your resumes, AI career coaching sessions, and consultations.\n            </p>\n          </div>\n          <div className=\"flex items-center gap-3\">\n            <Link href=\"/resumes/create\">\n              <Button size=\"sm\" className=\"gap-2\">\n                <Plus className=\"w-4 h-4\" /> Create Resume\n              </Button>\n            </Link>\n            <Link href=\"/consultations/book\">\n              <Button size=\"sm\" variant=\"outline\" className=\"gap-2\">\n                <CalendarCheck2 className=\"w-4 h-4\" /> Book Expert\n              </Button>\n            </Link>\n          </div>\n        </div>\n\n        {/* Stats Grid */}\n        <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5\">\n          <Card>\n            <CardContent className=\"p-6\">\n              <div className=\"flex items-center justify-between\">\n                <div>\n                  <p className=\"text-xs font-medium text-slate-500 uppercase tracking-wider\">Total Resumes</p>\n                  <p className=\"text-2xl font-bold text-slate-900 mt-1\">\n                    {loading ? <Skeleton className=\"h-8 w-12\" /> : metrics?.totalResumes ?? 0}\n                  </p>\n                </div>\n                <div className=\"w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center\">\n                  <FileText className=\"w-5 h-5\" />\n                </div>\n              </div>\n            </CardContent>\n          </Card>\n\n          <Card>\n            <CardContent className=\"p-6\">\n              <div className=\"flex items-center justify-between\">\n                <div>\n                  <p className=\"text-xs font-medium text-slate-500 uppercase tracking-wider\">AI Chat Sessions</p>\n                  <p className=\"text-2xl font-bold text-slate-900 mt-1\">\n                    {loading ? <Skeleton className=\"h-8 w-12\" /> : metrics?.totalChats ?? 0}\n                  </p>\n                </div>\n                <div className=\"w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center\">\n                  <BotMessageSquare className=\"w-5 h-5\" />\n                </div>\n              </div>\n            </CardContent>\n          </Card>\n\n          <Card>\n            <CardContent className=\"p-6\">\n              <div className=\"flex items-center justify-between\">\n                <div>\n                  <p className=\"text-xs font-medium text-slate-500 uppercase tracking-wider\">Upcoming Bookings</p>\n                  <p className=\"text-2xl font-bold text-slate-900 mt-1\">\n                    {loading ? <Skeleton className=\"h-8 w-12\" /> : metrics?.upcomingConsultations ?? 0}\n                  </p>\n                </div>\n                <div className=\"w-10 h-10 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center\">\n                  <CalendarCheck2 className=\"w-5 h-5\" />\n                </div>\n              </div>\n            </CardContent>\n          </Card>\n\n          <Card>\n            <CardContent className=\"p-6\">\n              <div className=\"flex items-center justify-between\">\n                <div>\n                  <p className=\"text-xs font-medium text-slate-500 uppercase tracking-wider\">Completed Sessions</p>\n                  <p className=\"text-2xl font-bold text-slate-900 mt-1\">\n                    {loading ? <Skeleton className=\"h-8 w-12\" /> : metrics?.completedConsultations ?? 0}\n                  </p>\n                </div>\n                <div className=\"w-10 h-10 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center\">\n                  <CheckCircle className=\"w-5 h-5\" />\n                </div>\n              </div>\n            </CardContent>\n          </Card>\n        </div>\n\n        {/* Recent Resumes & Upcoming Appointments */}\n        <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-8\">\n          {/* Recent Resumes */}\n          <Card>\n            <CardHeader className=\"flex flex-row items-center justify-between pb-2\">\n              <CardTitle className=\"text-base font-semibold\">Recent Resumes</CardTitle>\n              <Link href=\"/resumes\" className=\"text-xs font-semibold text-blue-600 hover:text-blue-700 flex items-center gap-1\">\n                View all <ArrowRight className=\"w-3.5 h-3.5\" />\n              </Link>\n            </CardHeader>\n            <CardContent>\n              {loading ? (\n                <div className=\"space-y-3\">\n                  <Skeleton className=\"h-14 w-full\" />\n                  <Skeleton className=\"h-14 w-full\" />\n                </div>\n              ) : !metrics?.recentResumes || metrics.recentResumes.length === 0 ? (\n                <div className=\"text-center py-8 text-slate-400\">\n                  <FileText className=\"w-8 h-8 mx-auto mb-2 opacity-40\" />\n                  <p className=\"text-xs\">No resumes created yet.</p>\n                  <Link href=\"/resumes/create\" className=\"mt-3 inline-block\">\n                    <Button size=\"sm\" variant=\"outline\">Create your first resume</Button>\n                  </Link>\n                </div>\n              ) : (\n                <div className=\"divide-y divide-slate-100\">\n                  {metrics.recentResumes.map((resume) => (\n                    <div key={resume._id} className=\"py-3 flex items-center justify-between\">\n                      <div>\n                        <Link href={`/resumes/${resume._id}/edit`} className=\"text-sm font-semibold text-slate-900 hover:text-blue-600\">\n                          {resume.title}\n                        </Link>\n                        <div className=\"flex items-center gap-2 mt-0.5\">\n                          <Badge variant=\"neutral\">\n                            {resume.template === 'ATS_CLASSIC' ? 'ATS Classic' : 'Modern Professional'}\n                          </Badge>\n                          <span className=\"text-[11px] text-slate-400\">Updated {formatDate(resume.updatedAt)}</span>\n                        </div>\n                      </div>\n                      <Link href={`/resumes/${resume._id}/preview`}>\n                        <Button size=\"sm\" variant=\"ghost\">Preview</Button>\n                      </Link>\n                    </div>\n                  ))}\n                </div>\n              )}\n            </CardContent>\n          </Card>\n\n          {/* Upcoming Consultations */}\n          <Card>\n            <CardHeader className=\"flex flex-row items-center justify-between pb-2\">\n              <CardTitle className=\"text-base font-semibold\">Upcoming Consultations</CardTitle>\n              <Link href=\"/consultations\" className=\"text-xs font-semibold text-blue-600 hover:text-blue-700 flex items-center gap-1\">\n                View all <ArrowRight className=\"w-3.5 h-3.5\" />\n              </Link>\n            </CardHeader>\n            <CardContent>\n              {loading ? (\n                <div className=\"space-y-3\">\n                  <Skeleton className=\"h-14 w-full\" />\n                  <Skeleton className=\"h-14 w-full\" />\n                </div>\n              ) : !metrics?.upcomingBookings || metrics.upcomingBookings.length === 0 ? (\n                <div className=\"text-center py-8 text-slate-400\">\n                  <CalendarCheck2 className=\"w-8 h-8 mx-auto mb-2 opacity-40\" />\n                  <p className=\"text-xs\">No upcoming expert consultations.</p>\n                  <Link href=\"/consultations/book\" className=\"mt-3 inline-block\">\n                    <Button size=\"sm\" variant=\"outline\">Browse available experts</Button>\n                  </Link>\n                </div>\n              ) : (\n                <div className=\"divide-y divide-slate-100\">\n                  {metrics.upcomingBookings.map((b) => (\n                    <div key={b._id} className=\"py-3 flex items-center justify-between\">\n                      <div>\n                        <p className=\"text-sm font-semibold text-slate-900\">{b.consultantId?.name || 'Consultant'}</p>\n                        <p className=\"text-xs text-slate-500 line-clamp-1\">{b.agenda}</p>\n                        <span className=\"text-[11px] text-slate-400 mt-0.5 block\">{new Date(b.startTime).toLocaleString()}</span>\n                      </div>\n                      <Badge variant={b.status === 'CONFIRMED' ? 'success' : 'warning'}>\n                        {b.status}\n                      </Badge>\n                    </div>\n                  ))}\n                </div>\n              )}\n            </CardContent>\n          </Card>\n        </div>\n      </div>\n    </DashboardLayout>\n  );\n}\n","Description":"Create authenticated Dashboard page component","Overwrite":true,"TargetFile":"C:\\Users\\PRIYANKA\\.gemini\\antigravity\\scratch\\career-platform\\frontend\\app\\dashboard\\page.tsx","toolAction":"Writing frontend/app/dashboard/page.tsx","toolSummary":"Create dashboard/page.tsx"}}]}
