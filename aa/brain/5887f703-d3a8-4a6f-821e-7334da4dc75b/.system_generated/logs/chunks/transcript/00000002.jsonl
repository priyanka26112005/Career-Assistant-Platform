rHTML={{ __html: resume.summary }}\\n            />\\n          </section>\\n        )}\\n\\n        {/* ATS Experience */}\\n        {resume.experience && resume.experience.length > 0 && (\\n          <section className=\\\"mb-5\\\">\\n            <h2 className=\\\"text-sm font-bold uppercase \n<truncated 13119 bytes>","Description":"\"Create live resume preview renderer for Modern Professional and ATS Classic templates\"","Overwrite":"true","TargetFile":"\"C:\\\\Users\\\\PRIYANKA\\\\.gemini\\\\antigravity\\\\scratch\\\\career-platform\\\\frontend\\\\components\\\\templates\\\\ResumePreview.tsx\"","toolAction":"\"Writing frontend/components/templates/ResumePreview.tsx\"","toolSummary":"\"Create ResumePreview.tsx\""}}],"truncated_fields":["tool_calls"]}
